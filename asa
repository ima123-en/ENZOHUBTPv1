local function _getPMRefs()
    if _PMRefs then return _PMRefs end
    _PMRefs = {}
    pcall(function()
        local pkg = ReplicatedStorage:FindFirstChild("Packages")
        local pm = pkg and pkg:FindFirstChild("PlayerMouse")
