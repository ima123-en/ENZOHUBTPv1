local function _sabInitSync()
	local _syncChannels = nil
	local _syncMod = nil
	local function _channelCount(t)
		if type(t)~="table" then return 0 end
		local h,n=0,0
		for _,v in next,t do
			n+=1
			if type(v)=="table" and type(rawget(v,"CacheTable"))=="table" then h+=1 end
			if n>=200 then break end
		end
		return h
	end
	local ok, mod = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Packages", 5):WaitForChild("Synchronizer", 5))
	end)
	if not ok or type(mod)~="table" then return nil end
	_syncMod = mod
	local gu = (debug and debug.getupvalue) or getupvalue
	if type(gu)~="function" then return nil end
	local ok2, up = pcall(gu, _syncMod.Get, 9)
	if ok2 and type(up)=="table" then
		local t3 = rawget(up,3)
		if _channelCount(t3)>0 then return t3 end
		if _channelCount(up)>0 then return up end
	end
	for _,fn in next,_syncMod do
		if type(fn)=="function" then
			for i=1,32 do
				local ok3,u = pcall(gu,fn,i)
				if not ok3 then break end
				if type(u)=="table" then
					if _channelCount(u)>0 then return u end
					for j=1,6 do
						local sub=rawget(u,j)
						if _channelCount(sub)>0 then return sub end
					end
				end
			end
		end
	end
	return nil
end

local _sabSyncChannels = nil
task.spawn(function()
	_sabSyncChannels = _sabInitSync()
end)

do
	local _xchan,_lastTry,_attempts = nil,0,0
	local _deepScans,_lastDeep,_mod = 0,0,nil
	local BOOT_T0 = os.clock()
	local function _channelCount(t)
		if type(t)~="table" then return 0 end
		local ok,hits = pcall(function()
			local h,n=0,0
			for _,v in next,t do
				n+=1
				if type(v)=="table" and type(rawget(v,"CacheTable"))=="table" then h+=1 end
				if n>=200 then break end
			end
			return h
		end)
		return (ok and hits) or 0
	end
	local function _getModule()
		if _mod then return _mod end
		local ok,m = pcall(function() return require(ReplicatedStorage.Packages.Synchronizer) end)
		if ok and type(m)=="table" then _mod=m; return _mod end
		return nil
	end
	local function _probe(mod)
		local gu = (debug and debug.getupvalue) or getupvalue
		if type(gu)~="function" then return nil end
		local best,bestN=nil,0
		local function consider(t) local n=_channelCount(t); if n>bestN then best,bestN=t,n end end
		local ok,up = pcall(gu,mod.Get,9)
		if ok and type(up)=="table" then
			consider(rawget(up,3)); if bestN>0 then return best end
			consider(up); if bestN>0 then return best end
		end
		return nil
	end
	local function _deepScan(mod)
		local gu = (debug and debug.getupvalue) or getupvalue
		if type(gu)~="function" then return nil end
		local best,bestN=nil,0
		local function consider(t) local n=_channelCount(t); if n>bestN then best,bestN=t,n end end
		for _,fn in next,mod do
			if type(fn)=="function" then
				for i=1,24 do
					local o,u = pcall(gu,fn,i)
					if not o then break end
					if type(u)=="table" then consider(u); for j=1,4 do consider(rawget(u,j)) end end
				end
			end
		end
		return best
	end
	local function _getChans()
		if _xchan then return _xchan end
		local gap = (os.clock()-BOOT_T0)<3.0 and 0.10 or 0.5
		if (os.clock()-_lastTry)<=gap then return nil end
		_lastTry=os.clock()
		local mod=_getModule()
		if not mod or _attempts>=40 then return nil end
		_attempts+=1
		local found=_probe(mod)
		if not found and _deepScans<3 and (os.clock()-_lastDeep)>1.5 then
			_lastDeep=os.clock(); _deepScans+=1; found=_deepScan(mod)
		end
		if found then _xchan=found end
		return _xchan
	end
	getgenv().SyncGet = function(name)
		local t=_getChans()
		if not t or not name then return nil end
		local ok,cd = pcall(rawget,t,name)
		if ok and type(cd)=="table" then return cd end
		local ok2,cd2 = pcall(function() return t[name] end)
		if ok2 and type(cd2)=="table" then return cd2 end
		return nil
	end
	getgenv().sProp = function(ch,key)
		if type(ch)~="table" or not key then return nil end
		local ct=rawget(ch,"CacheTable")
		if type(ct)~="table" then local ok,c2=pcall(function() return ch.CacheTable end); if ok and type(c2)=="table" then ct=c2 end end
		if type(ct)~="table" then return nil end
		local v=rawget(ct,key); if v~=nil then return v end
		local ok,v2=pcall(function() return ct[key] end); if ok then return v2 end
		return nil
	end
	getgenv().getChannel = function(plot)
		local ch=getgenv().SyncGet(plot.Name); if ch then return ch end
		local ord; pcall(function() ord=plot:GetAttribute("Order") end)
		if ord~=nil then ch=getgenv().SyncGet("Plot"..tostring(ord)) end
		return ch
	end
end

do
	local wallData={}
	local XRAY_ENABLED=false
	local oldIndex
	oldIndex=hookmetamethod(game,"__index",function(self,key)
		if not checkcaller() and XRAY_ENABLED then
			if key=="LocalTransparencyModifier" or key=="Transparency" then
				if wallData[self] then return 0 end
			end
		end
		return oldIndex(self,key)
	end)
	local function isBaseWall(part)
		if not part:IsA("BasePart") or not part.Anchored then return false end
		local n=part.Name:lower()
		local pn=(part.Parent and part.Parent.Name:lower()) or ""
		return n:find("wall") or n:find("base") or n:find("floor") or n:find("roof") or pn:find("base") or n:find("ceiling") or pn:find("plot")
	end
	local function applyStealthXRay(part,state)
		pcall(function()
			if state then
				if not wallData[part] then wallData[part]=part.LocalTransparencyModifier end
				part.LocalTransparencyModifier=0.45+(math.random()*0.07)
			else
				if wallData[part] then part.LocalTransparencyModifier=wallData[part] end
			end
		end)
	end
	local function refreshXRay()
		local pf=Workspace:FindFirstChild("Plots"); if not pf then return end
		local all=pf:GetDescendants()
		for i,v in ipairs(all) do
			if isBaseWall(v) then applyStealthXRay(v,XRAY_ENABLED) end
			if i%100==0 then RunService.Heartbeat:Wait() end
		end
	end
	Workspace:WaitForChild("Plots").DescendantAdded:Connect(function(child)
		if XRAY_ENABLED then task.wait(0.5); if isBaseWall(child) then applyStealthXRay(child,true) end end
	end)
	getgenv().ToggleBaseXRay=function(state) XRAY_ENABLED=state; refreshXRay() end
end

