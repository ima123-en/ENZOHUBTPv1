task.spawn(function()
	local plots = Workspace:WaitForChild("Plots", 30)
	if not plots then return end

	local AnimalsData_S, MutationsData_S, TraitsData_S
	task.spawn(function()
		pcall(function()
			local D = ReplicatedStorage:WaitForChild("Datas", 60)
			AnimalsData_S   = require(D:WaitForChild("Animals",   60))
			MutationsData_S = require(D:WaitForChild("Mutations", 30))
			TraitsData_S    = require(D:WaitForChild("Traits",    30))
		end)
	end)

	local function _calcGen(index, mutation, traits)
		return _sabCalcGen(index, mutation, traits)
	end

	local _sabSyncChannels = _sabSyncChannels or _sabInitSync()
	local function _sabChannelCount(t)
		if type(t)~="table" then return 0 end
		local h, n = 0, 0
		for _, v in next, t do
			n = n + 1
			if type(v) == "table" and type(rawget(v, "CacheTable")) == "table" then h = h + 1 end
			if n >= 200 then break end
		end
		return h
	end

	local function _sabInitSync()
		if _sabSyncChannels then return _sabSyncChannels end
		local ok, mod = pcall(function()
			return require(ReplicatedStorage:WaitForChild("Packages", 5):WaitForChild("Synchronizer", 5))
		end)
		if not ok or type(mod)~="table" then return nil end
		local gu = (debug and debug.getupvalue) or getupvalue
		if type(gu)~="function" then return nil end
		local ok2, up = pcall(gu, mod.Get, 9)
		if ok2 and type(up)=="table" then
			local t3 = rawget(up,3)
			if _sabChannelCount(t3)>0 then return t3 end
			if _sabChannelCount(up)>0 then return up end
		end
		for _,fn in next,mod do
			if type(fn)=="function" then
				for i=1,32 do
					local ok3,u = pcall(gu,fn,i)
					if not ok3 then break end
					if type(u)=="table" then
						if _sabChannelCount(u)>0 then return u end
						for j=1,6 do
							local sub=rawget(u,j)
							if _sabChannelCount(sub)>0 then return sub end
						end
					end
				end
			end
		end
		return nil
	end

	local function _sabReadChan(ch, key)
		if type(ch)~="table" or not key then return nil end
		local ct = rawget(ch, "CacheTable")
		if type(ct)~="table" then
			local ok, c2 = pcall(function() return ch.CacheTable end)
			if ok and type(c2)=="table" then ct = c2 end
		end
		if type(ct)~="table" then return nil end
		local v = rawget(ct, key)
		if v ~= nil then return v end
		local ok, v2 = pcall(function() return ct[key] end)
		return ok and v2 or nil
	end

	local function _sabOwnerIsMe(owner)
		if not owner then return false end
		if typeof(owner)=="Instance" and owner==LocalPlayer then return true end
		if type(owner)=="number" and owner==LocalPlayer.UserId then return true end
		if type(owner)=="string" then local o=owner:lower(); return o==LocalPlayer.Name:lower() or o==LocalPlayer.DisplayName:lower() end
		if type(owner)=="table" then
			if owner.UserId==LocalPlayer.UserId then return true end
			if owner.Name and owner.Name:lower()==LocalPlayer.Name:lower() then return true end
		end
		return false
	end

	local function _sabIsMyPlot(plot)
		local sign = plot:FindFirstChild("PlotSign")
		if not sign then return false end
		local yb = sign:FindFirstChild("YourBase")
		if yb and yb:IsA("BillboardGui") and yb.Enabled then return true end
		local gui = sign:FindFirstChildWhichIsA("SurfaceGui", true)
		if gui then
			for _, lbl in ipairs(gui:GetDescendants()) do
				if lbl:IsA("TextLabel") and lbl.Text then
					local t = lbl.Text:lower()
					if t:find(LocalPlayer.Name:lower(), 1, true) or t:find(LocalPlayer.DisplayName:lower(), 1, true) then return true end
				end
			end
		end
		return false
	end

	local _sabPodiumCache = setmetatable({}, { __mode = "k" })
	local function _sabPodiumPos(podium)
		if _sabPodiumCache[podium] then return _sabPodiumCache[podium] end
		local ok, cf = pcall(function() return podium:GetPivot() end)
		if ok and cf and cf.Position.Magnitude > 1 then
			_sabPodiumCache[podium] = cf.Position
			return cf.Position
		end
		return nil
	end

	local _sabPromptCache = setmetatable({}, { __mode = "v" })
	local function _sabFindPrompt(plotName, slot)
		local uid = tostring(plotName) .. "_" .. tostring(slot)
		local cached = _sabPromptCache[uid]
		if cached and cached.Parent then return cached end
		local plot = plots:FindFirstChild(tostring(plotName))
		if not plot then return nil end
		local podiums = plot:FindFirstChild("AnimalPodiums")
		if not podiums then return nil end
		local podium = podiums:FindFirstChild(tostring(slot))
		if not podium then return nil end
		local base   = podium:FindFirstChild("Base")
		local spawn  = base and base:FindFirstChild("Spawn")
		local attach = spawn and spawn:FindFirstChild("PromptAttachment")
		if not attach then return nil end
		for _, p in ipairs(attach:GetChildren()) do
			if p:IsA("ProximityPrompt") then
				_sabPromptCache[uid] = p
				return p
			end
		end
		return nil
	end

	local _sabAllPets = {}

	local function _sabScan()
		local result = {}
		local catalog = {}
		if AnimalsData_S then
			for idx, info in pairs(AnimalsData_S) do
				if type(info) == "table" then
					catalog[tostring(idx):lower()] = idx
					if info.DisplayName then catalog[info.DisplayName:lower()] = idx end
				end
			end
		end

		if _sabSyncChannels then
			for plotKey, ch in pairs(_sabSyncChannels) do
				if type(ch) ~= "table" then continue end
				local owner = _sabReadChan(ch, "Owner")
				if _sabOwnerIsMe(owner) then continue end
				local al = _sabReadChan(ch, "AnimalList")
				if type(al) ~= "table" then continue end

				local plot = plots:FindFirstChild(tostring(plotKey))
				if not plot then
					local num = tostring(plotKey):match("%d+")
					if num then
						for _, pl in ipairs(plots:GetChildren()) do
							local ok, ord = pcall(function() return pl:GetAttribute("Order") end)
							if ok and ord and tostring(ord) == num then plot = pl; break end
						end
					end
				end
				if not plot then continue end

				for slot, ad in pairs(al) do
					if type(ad) ~= "table" then continue end
					local idx = ad.Index
					if not idx then continue end
					local info = AnimalsData_S and AnimalsData_S[idx]
					if not info then continue end
					if info.Egg or info.LuckyBlock then continue end
					local disp = info.DisplayName or idx
					if tostring(disp):match("^%d+$") then continue end
					local mut    = ad.Mutation or "None"
					local traits = ad.Traits
					local gen    = _calcGen(idx, mut, type(traits) == "table" and traits or nil)
					local pos
					local podiums = plot:FindFirstChild("AnimalPodiums")
					if podiums then
						local podium = podiums:FindFirstChild(tostring(slot))
						if podium then pos = _sabPodiumPos(podium) end
					end
					table.insert(result, {
						name     = disp,
						index    = idx,
						gen      = gen,
						mutation = mut,
						traits   = traits,
						plot     = plot.Name,
						slot     = tostring(slot),
						uid      = plot.Name .. "_" .. tostring(slot),
						pos      = pos,
						source   = "sync",
					})
				end
			end
		end

		if #result == 0 and AnimalsData_S then
			for _, plot in ipairs(plots:GetChildren()) do
				if _sabIsMyPlot(plot) then continue end
				local podiums = plot:FindFirstChild("AnimalPodiums")
				if not podiums then continue end
				for _, podium in ipairs(podiums:GetChildren()) do
					if not tonumber(podium.Name) then continue end
					local base   = podium:FindFirstChild("Base")
					local spawn  = base and base:FindFirstChild("Spawn")
					local attach = spawn and spawn:FindFirstChild("PromptAttachment")
					if not attach then continue end
					local prompt = nil
					for _, p in ipairs(attach:GetChildren()) do
						if p:IsA("ProximityPrompt") then prompt = p; break end
					end
					if not prompt then continue end
					local objText = tostring(prompt.ObjectText or "")
					if objText == "" then continue end
					local idx = catalog[objText:lower()]
					if not idx then continue end
					local info = AnimalsData_S[idx]
					if not info or info.Egg or info.LuckyBlock then continue end
					local disp = info.DisplayName or idx
					if tostring(disp):match("^%d+$") then continue end
					local pos = _sabPodiumPos(podium)
					if not pos then continue end
					local mut = podium:GetAttribute("Mutation") or "None"
					local gen = _calcGen(idx, mut, nil)
					table.insert(result, {
						name     = disp,
						index    = idx,
						gen      = gen,
						mutation = mut,
						plot     = plot.Name,
						slot     = podium.Name,
						uid      = plot.Name .. "_" .. podium.Name,
						pos      = pos,
						source   = "visual",
					})
				end
				task.wait()
			end
		end

		_sabAllPets = result
	end

	local function _sabNormName(s)
		return tostring(s or ""):lower():gsub("[%s%-_'%.:+]", "")
	end

	local function _sabBuildPriMap()
		local list = Hub.State.priorityList or {}
		local map  = {}
		for i, name in ipairs(list) do
			local k = _sabNormName(name)
			if k ~= "" and not map[k] then map[k] = i end
		end
		return map
	end

	local function _sabGetHRP()
		local c = LocalPlayer.Character
		return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso"))
	end

	local function _sabDistTo(pos)
		local hrp = _sabGetHRP()
		if not hrp or not pos then return math.huge end
		return (hrp.Position - pos).Magnitude
	end

	local _sabGrabBoostUntil = 0

	local function _sabGetRadius()
		local base = _sabFirstSteal and 80 or 42
		if os.clock() < _sabGrabBoostUntil then base = math.max(base, 130) end
		return math.clamp(base, 10, 150)
	end

	local function _sabSelectTarget()
		local manUID = getgenv().SMKT_SelectedUID
		if type(manUID) == "string" and manUID ~= "" then
			for _, pet in ipairs(_sabAllPets) do
				if pet.uid == manUID then return pet end
			end
			local manData = getgenv().SMKT_SelectedData
			if manData and manData.plot and manData.slot then
				for _, pet in ipairs(_sabAllPets) do
					if pet.plot == tostring(manData.plot) and pet.slot == tostring(manData.slot) then
						return pet
					end
				end
			end
			if manData and manData.name then
				for _, pet in ipairs(_sabAllPets) do
					if pet.name == manData.name then return pet end
				end
			end
			getgenv().SMKT_SelectedUID = nil
			getgenv().SMKT_SelectedData = nil
		end
		if #_sabAllPets == 0 then return nil end
		local mode = AG_State.Mode or "Priority"
		if mode == "Nearest" then
			local best, bestDist = nil, math.huge
			for _, pet in ipairs(_sabAllPets) do
				local d = _sabDistTo(pet.pos)
				if d < bestDist then bestDist = d; best = pet end
			end
			return best
		else
			local priMap = _sabBuildPriMap()
			table.sort(_sabAllPets, function(a, b)
				local pa = priMap[_sabNormName(a.name)] or priMap[_sabNormName(a.index)]
				local pb = priMap[_sabNormName(b.name)] or priMap[_sabNormName(b.index)]
				if pa and pb then if pa ~= pb then return pa < pb end
				elseif pa then return true
				elseif pb then return false end
				if a.gen ~= b.gen then return a.gen > b.gen end
				if a.source ~= b.source then return a.source == "sync" end
				return a.uid < b.uid
			end)
			return _sabAllPets[1]
		end
	end

	local _sabLastFire      = setmetatable({}, { __mode = "k" })
	local _sabLastEnableFire = setmetatable({}, { __mode = "k" })
	local FIRE_BURST        = 35
	local FIRE_DEBOUNCE     = 0.12
	local ENABLE_BURST      = 35
	local ENABLE_COOLDOWN   = 0.08
	local HOLD_DURATION     = 1.3
	local _sabFirstSteal    = true
	local _sabCurrentHold   = HOLD_DURATION
	local STEAL_PROXIMITY   = 60

	local function _sabFireBurst(prompt, burst, debounce)
		if not prompt or not prompt.Parent or not prompt.Enabled then return end
		local now  = os.clock()
		local last = _sabLastFire[prompt] or 0
		if now - last < (debounce or FIRE_DEBOUNCE) then return end
		_sabLastFire[prompt] = now
		local fireFn = fireproximityprompt or getgenv().__SabcomFirePrompt
		if type(fireFn) == "function" then
			for _ = 1, (burst or FIRE_BURST) do pcall(fireFn, prompt, 0) end
		else
			pcall(function()
				prompt.MaxActivationDistance = math.huge
				prompt:InputHoldBegin()
			end)
			task.delay(HOLD_DURATION, function() pcall(function() prompt:InputHoldEnd() end) end)
		end
	end

	local _sabStealCallbacks = setmetatable({}, { __mode = "k" })
	local _sabStealActive    = false
	local _sabStealStart     = 0

	local function _sabBuildCallbacks(prompt)
		if _sabStealCallbacks[prompt] then return end
		if type(getconnections) ~= "function" then return end
		local data = { hold = {}, trigger = {}, holdEnd = {}, ready = true }
		local ok1, c1 = pcall(getconnections, prompt.PromptButtonHoldBegan)
		if ok1 and type(c1) == "table" then
			for _, conn in ipairs(c1) do
				if type(conn.Function) == "function" then table.insert(data.hold, conn.Function) end
			end
		end
		local ok2, c2 = pcall(getconnections, prompt.Triggered)
		if ok2 and type(c2) == "table" then
			for _, conn in ipairs(c2) do
				if type(conn.Function) == "function" then table.insert(data.trigger, conn.Function) end
			end
		end
		local ok3, c3 = pcall(getconnections, prompt.PromptButtonHoldEnded)
		if ok3 and type(c3) == "table" then
			for _, conn in ipairs(c3) do
				if type(conn.Function) == "function" then table.insert(data.holdEnd, conn.Function) end
			end
		end
		if #data.hold > 0 or #data.trigger > 0 then
			_sabStealCallbacks[prompt] = data
		end
	end

	local function _sabExecuteHold(prompt)
		local data = _sabStealCallbacks[prompt]
		if not data or not data.ready then return false end
		data.ready = false
		_sabStealActive = true
		_sabStealStart  = tick()
		task.spawn(function()
			local holdDur = (_sabFirstSteal and 2.6 or HOLD_DURATION)
			_sabFirstSteal = false
			_sabCurrentHold = holdDur
			for _, fn in ipairs(data.hold) do task.spawn(fn) end
			pcall(function()
				prompt.MaxActivationDistance = math.huge
				prompt:InputHoldBegin()
			end)

			task.wait(holdDur)
			for _, fn in ipairs(data.trigger) do task.spawn(fn) end
			pcall(function() prompt:InputHoldEnd() end)
