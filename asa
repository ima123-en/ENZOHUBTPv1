	local _syncChannels = _sabSyncChannels
	local function _channelCount(t)
		if type(t)~="table" then return 0 end
		local ok,hits=pcall(function()
			local h,n=0,0
			for _,v in next,t do n=n+1; if type(v)=="table" and type(rawget(v,"CacheTable"))=="table" then h=h+1 end; if n>=200 then break end end
			return h
		end)
		return (ok and hits) or 0
	end
	local function initSync()
		if _syncChannels then return true end
		if not _sabSyncChannels then _sabSyncChannels = _sabInitSync() end
		if _sabSyncChannels then _syncChannels = _sabSyncChannels; return true end
		local ok,mod=pcall(function() return require(ReplicatedStorage.Packages.Synchronizer) end)
		if not ok or type(mod)~="table" then return false end
		local gu=(debug and debug.getupvalue) or getupvalue
		if type(gu)~="function" then return false end
		local function probe()
			local ok2,up=pcall(gu,mod.Get,9)
			if ok2 and type(up)=="table" then
				local t3=rawget(up,3); if _channelCount(t3)>0 then _syncChannels=t3; return true end
				if _channelCount(up)>0 then _syncChannels=up; return true end
			end
			return false
		end
		if probe() then return true end
		for _,fn in next,mod do
			if type(fn)=="function" then
				for i=1,24 do
					local ok3,u=pcall(gu,fn,i); if not ok3 then break end
					if type(u)=="table" then
						if _channelCount(u)>0 then _syncChannels=u; return true end
						for j=1,4 do local sub=rawget(u,j); if _channelCount(sub)>0 then _syncChannels=sub; return true end end
					end
				end
			end
		end
		return false
	end
	local function readChannel(ch,key)
		if type(ch)~="table" then return nil end
		local ct=rawget(ch,"CacheTable")
		if type(ct)~="table" then local ok,c2=pcall(function() return ch.CacheTable end); if ok and type(c2)=="table" then ct=c2 end end
		if type(ct)~="table" then return nil end
		local v=rawget(ct,key); if v~=nil then return v end
		local ok,v2=pcall(function() return ct[key] end); return ok and v2 or nil
	end
	local function ownerIsMe(owner)
		if not owner then return false end
		if typeof(owner)=="Instance" and owner==LocalPlayer then return true end
		if type(owner)=="number" and owner==LocalPlayer.UserId then return true end
		if type(owner)=="string" then local o=owner:lower(); return o==LocalPlayer.Name:lower() or o==LocalPlayer.DisplayName:lower() end
		if type(owner)=="table" then
			if owner.UserId==LocalPlayer.UserId then return true end
			if owner.Name and owner.Name:lower()==LocalPlayer.Name:lower() then return true end
		end
		return false
	end
	local function resolveOwner(owner)
		if not owner then return "?" end
		if typeof(owner)=="Instance" and owner:IsA("Player") then return owner.DisplayName or owner.Name end
		if type(owner)=="number" then local p=Players:GetPlayerByUserId(owner); return p and (p.DisplayName or p.Name) or tostring(owner) end
		if type(owner)=="string" and owner~="" then return owner end
		if type(owner)=="table" and owner.Name then return tostring(owner.Name) end
		return "?"
	end
	local function fmt(n)
		n=tonumber(n) or 0
		if n>=1e12 then return string.format("%.2fT",n/1e12)
		elseif n>=1e9 then return string.format("%.2fB",n/1e9)
		elseif n>=1e6 then return string.format("%.2fM",n/1e6)
		elseif n>=1e3 then return string.format("%.1fK",n/1e3)
		else return tostring(math.floor(n)) end
	end
