local function makeSlider(parent,y,label,minV,maxV,getV,setV,fmt)
	local frame=Instance.new("Frame"); frame.Size=UDim2.new(0.9,0,0,32)
	frame.Position=UDim2.new(0.05,0,0,y); frame.BackgroundColor3=THEME_PANEL
	frame.BorderSizePixel=0; frame.Parent=parent
	Instance.new("UICorner",frame).CornerRadius=UDim.new(0,2)
	local fs=Instance.new("UIStroke",frame); fs.Color=THEME_BORDER; fs.Thickness=1
	local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(0.6,0,0,16)
	lbl.Position=UDim2.new(0,8,0,4); lbl.BackgroundTransparency=1; lbl.Text=label:upper()
	lbl.Font=THEME_FONT; lbl.TextSize=10; lbl.TextColor3=THEME_TEXT_PRIMARY
	lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=frame
	local val=Instance.new("TextLabel"); val.Size=UDim2.new(0,70,0,16)
	val.Position=UDim2.new(1,-78,0,4); val.BackgroundTransparency=1; val.Font=THEME_FONT
	val.TextSize=10; val.TextColor3=THEME_ACCENT; val.TextXAlignment=Enum.TextXAlignment.Right; val.Parent=frame
	local bar=Instance.new("Frame"); bar.Size=UDim2.new(1,-16,0,6)
	bar.Position=UDim2.new(0,8,1,-12); bar.BackgroundColor3=THEME_BG; bar.BorderSizePixel=0; bar.Parent=frame
	Instance.new("UICorner",bar).CornerRadius=UDim.new(0,2)
	local fill=Instance.new("Frame"); fill.Size=UDim2.new(0,0,1,0); fill.BackgroundColor3=THEME_ACCENT
	fill.BorderSizePixel=0; fill.Parent=bar
	Instance.new("UICorner",fill).CornerRadius=UDim.new(0,2)
	local knob=Instance.new("Frame"); knob.Size=UDim2.new(0,10,0,10)
	knob.Position=UDim2.new(0,-5,0.5,-5); knob.BackgroundColor3=THEME_TEXT_PRIMARY
	knob.BorderSizePixel=0; knob.Parent=bar
	Instance.new("UICorner",knob).CornerRadius=UDim.new(0,1)
	local dragging=false
	local function updateVis(v,instant)
		v=math.clamp(v,minV,maxV)
		local alpha=(v-minV)/(maxV-minV); local len=bar.AbsoluteSize.X; local px=alpha*len
		val.Text=fmt and fmt(v) or string.format("%.2f",v)
		if instant then fill.Size=UDim2.new(0,px,1,0); knob.Position=UDim2.new(0,px-5,0.5,-5)
		else
			TweenService:Create(fill,TweenInfo.new(0.1),{Size=UDim2.new(0,px,1,0)}):Play()
			TweenService:Create(knob,TweenInfo.new(0.1),{Position=UDim2.new(0,px-5,0.5,-5)}):Play()
		end
	end
	local function fromAlpha(a)
		a=math.clamp(a,0,1); local v=minV+(maxV-minV)*a; setV(v); updateVis(v,false); SaveConfig()
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then
			dragging=true; isInteractingWithSlider=true
			fromAlpha((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X) end
	end)
	knob.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true; isInteractingWithSlider=true end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
			fromAlpha((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X) end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false; isInteractingWithSlider=false end
	end)
	task.defer(function() updateVis(getV(),true) end)
end

