local function doClone(nearPos)
	if _G._UnifiedIsCloning then return false end
	_G._UnifiedIsCloning = true
	local success = false
	pcall(function()
		if not placeCloneOnly(nearPos) then return end
		local char = LP.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local prePos = hrp.Position
		local function swapped()
			if not cloneAlive() then return true end
			local c = LP.Character
			local h = c and c:FindFirstChild("HumanoidRootPart")
			return h and (h.Position - prePos).Magnitude > 3
		end
		local function waitSwap(sec)
			local t0 = os.clock()
			while os.clock() - t0 < sec do
				if swapped() then return true end
				RunService.Heartbeat:Wait()
			end
			return false
		end
		local remote = getQuantumTeleportRemote()
		if remote then
			pcall(function() remote:FireServer() end)
			if waitSwap(0.5) then success = true; return end
		end
		if pressSwapButton() then
			if waitSwap(0.5) then success = true; return end
		end
		success = manualCloneTeleport()
	end)
	_G._UnifiedIsCloning = false
	return success
end

