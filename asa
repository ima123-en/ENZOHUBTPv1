local function _sabCalcGen(idx, mut, traits)
	if not AnimalsData or not AnimalsData[idx] then return 0 end
	local info = AnimalsData[idx]
	local base = tonumber(info.Generation) or 0
	local mult = 1
	if mut and mut ~= "None" and MutationsData then
		local m = MutationsData[mut]
		if type(m)=="table" and m.Modifier then mult = mult + (tonumber(m.Modifier) or 0) end
	end
	if type(traits)=="table" and TraitsData then
		for _, t in ipairs(traits) do
			local tr = TraitsData[t]
			if type(tr)=="table" and tr.MultiplierModifier then mult = mult + (tonumber(tr.MultiplierModifier) or 0) end
		end
	end
	return math.floor(base * mult + 0.5)
end

