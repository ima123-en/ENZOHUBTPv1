			if not _sabSyncChannels then _sabSyncChannels = _sabInitSync() end
			local target = _sabSelectTarget()
			if not target then
				AG_State.IsStealing    = false
				AG_State.CurrentPetName = ""
				continue
			end
			local dist = _sabDistTo(target.pos)
			if dist > _sabGetRadius() then
				AG_State.IsStealing    = false
				AG_State.CurrentPetName = ""
				AG_State.StealProgress  = 0
