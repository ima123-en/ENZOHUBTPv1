local function _muteAndStopPull(tool, hrp)
    if tool then
        for _, s in ipairs(tool:GetDescendants()) do
            if s:IsA("Sound") then pcall(function() s.Volume = 0; s:Stop() end)
            elseif s:IsA("Beam") then pcall(function() s.Enabled = false; s.Attachment0 = nil end) end
        end
    end
    if hrp then
        local fp = hrp:FindFirstChild("FlightPower")
        if fp then fp:Destroy() end
        if not _G.SMKTIsTeleporting then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
end

local function _holdNoPull(tool, hrp, seconds)
    local t0 = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        _muteAndStopPull(tool, hrp)
        if os.clock() - t0 > seconds then conn:Disconnect(); _muteAndStopPull(tool, hrp) end
    end)
end

local function _grappleFireAt(tool, pos, alvo, char)
    local refs = _getPMRefs()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    _muteAndStopPull(tool, hrp)
    local mira = CFrame.new(pos)
    local antes = {}
    for i, t in ipairs(refs) do
        antes[i] = { rawget(t, "Hit"), rawget(t, "Target") }
        pcall(function() t.Hit = mira; t.Target = alvo end)
    end
    local ok = pcall(function() tool:Activate() end)
    if not ok and typeof(firesignal) == "function" then
        ok = pcall(function() firesignal(tool.Activated) end)
    end
    _muteAndStopPull(tool, hrp)
    _holdNoPull(tool, hrp, tonumber(_G.TacoHeldPullSeconds) or 0.6)
    task.spawn(function()
        for _ = 1, 4 do
            for _, t in ipairs(refs) do pcall(function() t.Hit = mira; t.Target = alvo end) end
            _muteAndStopPull(tool, hrp)
            RunService.Heartbeat:Wait()
        end
        for i, t in ipairs(refs) do
            local a = antes[i]
            pcall(function() t.Hit = a[1]; t.Target = a[2] end)
        end
        _muteAndStopPull(tool, hrp)
    end)
    return ok
end

