local function SaveConfig()
    if writefile then
        local ok = pcall(function()
            writefile(SAVE_KEY, game:GetService("HttpService"):JSONEncode(CONFIG))
        end)
        if ok then return end
    end
    _G["__SMKTHubConfig_" .. LP.UserId] = game:GetService("HttpService"):JSONEncode(CONFIG)
end

local _lastSaveT = 0
local _pendingSave = false
local function SaveConfigDebounced()
    local now = os.clock()
    if now - _lastSaveT > 0.1 then
        _lastSaveT = now
        SaveConfig()
    elseif not _pendingSave then
        _pendingSave = true
        task.delay(0.15, function()
            _pendingSave = false
            _lastSaveT = os.clock()
            SaveConfig()
        end)
    end
end

local function LoadConfig()
    if readfile and isfile then
        local ok, exists = pcall(isfile, SAVE_KEY)
        if ok and exists then
            local okRead, raw = pcall(readfile, SAVE_KEY)
            if okRead and type(raw) == "string" and #raw > 0 then
                local okDec, data = pcall(function()
                    return game:GetService("HttpService"):JSONDecode(raw)
                end)
                if okDec and type(data) == "table" then
                    for k, v in pairs(data) do
                        if CONFIG[k] ~= nil and type(v) == type(CONFIG[k]) then CONFIG[k] = v end
                    end
                    if type(CONFIG.GuiScale) == "number" then CONFIG.GuiScale = math.clamp(CONFIG.GuiScale, 1, 100) end
                    return
                end
            end
        end
    end
    local raw = _G["__SMKTHubConfig_" .. LP.UserId]
    if type(raw) == "string" and #raw > 0 then
        local ok, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(raw)
        end)
        if ok and type(data) == "table" then
            for k, v in pairs(data) do
                if CONFIG[k] ~= nil and type(v) == type(CONFIG[k]) then CONFIG[k] = v end
            end
            if type(CONFIG.GuiScale) == "number" then CONFIG.GuiScale = math.clamp(CONFIG.GuiScale, 1, 100) end
        end
    end
end
