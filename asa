	local _sabTrackedPrompts = setmetatable({}, { __mode = "k" })

	local function _sabIsTargetPrompt(prompt)
		local sel = getgenv().SMKT_SelectedData
		if not sel then return false end
		local plotInst = prompt:FindFirstAncestorWhichIsA("Model")
		while plotInst and plotInst.Parent ~= plots do
			plotInst = plotInst.Parent
		end
		if not plotInst or plotInst.Parent ~= plots then return false end
		local podiums = plotInst:FindFirstChild("AnimalPodiums")
		if not podiums then return false end
		local node = prompt
		while node and node ~= podiums do
			if node.Parent == podiums then
				return (plotInst.Name .. "_" .. node.Name) == sel.uid
			end
			node = node.Parent
		end
		return false
	end

	local function _sabTryEnableFire(prompt)
		if not AG_State.Active then return end
		if not prompt or not prompt.Parent or not prompt.Enabled then return end
		if not _sabIsTargetPrompt(prompt) and AG_State.Mode ~= "Nearest" then return end
		local hrp = _sabGetHRP()
		local pos
		do
			local p = prompt.Parent
			if p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then pos = p.Parent.Position
			elseif p:IsA("BasePart") then pos = p.Position end
		end
		if not pos or not hrp then return end
		if (hrp.Position - pos).Magnitude > _sabGetRadius() then return end
		local now = os.clock()
		local le  = _sabLastEnableFire[prompt] or 0
		if now - le < ENABLE_COOLDOWN then return end
		_sabLastEnableFire[prompt] = now
		_sabFireBurst(prompt, ENABLE_BURST, 0)
		_sabBuildCallbacks(prompt)
		if _sabStealCallbacks[prompt] then _sabExecuteHold(prompt) end
	end

	local function _sabTrackPrompt(prompt)
		if _sabTrackedPrompts[prompt] then return end
		_sabTrackedPrompts[prompt] = true
		task.defer(function() _sabTryEnableFire(prompt) end)
		prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
			if prompt.Enabled then _sabTryEnableFire(prompt) end
		end)
		prompt.AncestryChanged:Connect(function()
			if not prompt:IsDescendantOf(Workspace) then
				_sabTrackedPrompts[prompt] = nil
				_sabLastFire[prompt] = nil
				_sabLastEnableFire[prompt] = nil
				_sabStealCallbacks[prompt] = nil
			end
		end)
	end

	local function _sabScanPrompts()
		for _, plot in ipairs(plots:GetChildren()) do
			local podiums = plot:FindFirstChild("AnimalPodiums")
			if podiums then
				for _, podium in ipairs(podiums:GetChildren()) do
					local base   = podium:FindFirstChild("Base")
					local spawn  = base and base:FindFirstChild("Spawn")
					local attach = spawn and spawn:FindFirstChild("PromptAttachment")
					if attach then
						for _, p in ipairs(attach:GetChildren()) do
							if p:IsA("ProximityPrompt") then _sabTrackPrompt(p) end
						end
					end
				end
			end
		end
	end

