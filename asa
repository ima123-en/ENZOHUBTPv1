        _G.__TacoUpperTP = isUpper
        local baseEntry = getBaseEntry(baseIdx, isUpper, hrp.Position.Z)
        local destPos = baseEntry.pos
        local facingDir = baseEntry.look
        local _frontApproach = true

        _G.TPStatus = "traveling"
        local _nearPet = brainPos and (hrp.Position - brainPos).Magnitude <= (tonumber(_G.TacoNoGrappleNear) or 45)
        if CONFIG.ToolChoice == "Grapple" and _G.TacoGrappleEveryTP ~= false and not _nearPet then
            pcall(_grappleFireAndUnequip, destPos)
