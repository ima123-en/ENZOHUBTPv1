end

local function computeRoute(startPos, targetPos, facingDir)
    if _clearWide(startPos, targetPos) then return { startPos, targetPos } end
    do
        local key = _routeKey(startPos, targetPos)
        local e = _routeCache[key]
        if e then
            if os.clock() - e.t > 20 then _routeCache[key] = nil
            else
                local full = { startPos }
                for _, p in ipairs(e.pts) do full[#full + 1] = p end
                if _routeClear(full) then
                    local copy = {}
                    for i, p in ipairs(e.pts) do copy[i] = p end
                    return copy
                end
                _routeCache[key] = nil
            end
        end
    end
    local fromPos, toPos = startPos, targetPos
    local centerPatch = nil
    if _segmentCrossesCenter(fromPos, toPos) and not _clearWide(fromPos, toPos) then
        centerPatch = _findBestCenterDetour(fromPos, toPos, fromPos.Y)
        if centerPatch and #centerPatch > 0 then fromPos = centerPatch[#centerPatch] end
    end
    local rowPatch = _findRowDetour(fromPos, toPos, fromPos.Y)
    if rowPatch and #rowPatch > 0 then fromPos = rowPatch[#rowPatch] end
    local function _finish(route)
        local merged = {}
        if centerPatch then for _, p in ipairs(centerPatch) do merged[#merged + 1] = p end end
        if rowPatch then for _, p in ipairs(rowPatch) do merged[#merged + 1] = p end end
        for _, p in ipairs(route) do merged[#merged + 1] = p end
        merged = _dedupe(merged)
        if #merged == 0 or (merged[#merged] - targetPos).Magnitude > 0.5 then
            merged[#merged + 1] = targetPos
        end
        _routeCache[_routeKey(startPos, targetPos)] = { t = os.clock(), pts = merged }
        return merged
    end
    if _clearWide(fromPos, toPos) then return _finish({ toPos }) end
    if (tonumber(_G.SMKTPathCell) or 4) >= 4 then
        local baseY = math.max(fromPos.Y, toPos.Y, 26)
        for _, extra in ipairs({ 12, 26, 44 }) do
            local cruiseY = baseY + extra
            local up = Vector3.new(fromPos.X, cruiseY, fromPos.Z)
            local over = Vector3.new(toPos.X, cruiseY, toPos.Z)
            if _segmentsClear({ fromPos, up, over, toPos }) then return _finish({ up, over, toPos }) end
        end
    end
    local vr = voxelRoute(fromPos, toPos)
    if vr and #vr > 0 then
        local full = { fromPos }
        for _, p in ipairs(vr) do full[#full + 1] = p end
        local pulled = _pullWide(full)
        table.remove(pulled, 1)
        if #pulled > 0 then return _finish(pulled) end
        return _finish(vr)
    end
    local entry = facingDir and (toPos - facingDir * 14) or toPos
    local best, bestLen = nil, math.huge
    local function consider(pts)
        if not pts or #pts < 2 then return end
        if not _segmentsClear(pts) then return end
        local pulled = _pullWide(pts)
        local L = 0
        local prev = pulled[1]
        for k = 2, #pulled do L = L + (pulled[k] - prev).Magnitude; prev = pulled[k] end
        if L < bestLen then best, bestLen = pulled, L end
    end
    local dirF = Vector3.new(entry.X - fromPos.X, 0, entry.Z - fromPos.Z)
    if dirF.Magnitude > 0.1 then
        dirF = dirF.Unit
        local perp = Vector3.new(-dirF.Z, 0, dirF.X)
        local midBase = (fromPos + entry) * 0.5
        for _, off in ipairs({ 14, -14, 24, -24, 38, -38, 56, -56, 76, -76 }) do
            consider({ fromPos, midBase + perp * off, entry })
            consider({ fromPos, fromPos + perp * off, entry + perp * off, entry })
        end
        for _, upY in ipairs({ 10, 20, 32 }) do
            consider({ fromPos, midBase + Vector3.new(0, upY, 0), entry })
        end
    end
    if not best then
        local groundTo = Vector3.new(entry.X, fromPos.Y, entry.Z)
        local path = PathfindingService:CreatePath({
            AgentRadius = 16, AgentHeight = 5, AgentCanJump = true, AgentJumpHeight = 10, AgentMaxSlope = 89,
        })
        local FLOAT = 5
        local nav = { fromPos }
        local success
        pcall(function() path:ComputeAsync(Vector3.new(fromPos.X, fromPos.Y, fromPos.Z), groundTo); success = true end)
        if success and path.Status == Enum.PathStatus.Success then
            local last = fromPos
            for _, wp in ipairs(path:GetWaypoints()) do
                if (wp.Position - last).Magnitude >= 8 then
                    nav[#nav + 1] = wp.Position + Vector3.new(0, FLOAT, 0)
                    last = wp.Position
                end
            end
        end
        nav[#nav + 1] = entry + Vector3.new(0, FLOAT, 0)
        nav = _pushOffWalls(nav)
        consider(nav)
    end
    local route = best
    if route and (route[1] - fromPos).Magnitude < 1.5 then table.remove(route, 1) end
    if not route then
        local rep = _repairBlockedRoute({ fromPos, toPos }, toPos)
        if rep and #rep > 1 then table.remove(rep, 1); route = rep end
    end
    if not route then route = { toPos } end
    if (route[#route] - toPos).Magnitude > 0.5 then route[#route + 1] = toPos end
    return _finish(route)
end

local function smktVelMove(hrp, waypoints, speedOverride)
    local state = { done = false, reason = nil }
    if not hrp or not hrp.Parent or #waypoints == 0 then
        state.done = true
        return function() end, state
    end
    local wpIdx = 1
    local conn
    local stallSec = tonumber(_G.SMKTStallSec) or 0.6
    local repushAt = math.min(tonumber(_G.SMKTRepushAt) or 0.9, stallSec * 0.6)
    local lastDist = math.huge
    local stallT = os.clock()
    local baseSpeed = _pingAdjustSpeed(speedOverride or tonumber(_G.NeegyCruise) or 400)
    local cornerSpd = tonumber(_G.SMKTCornerSpeed) or 140
    local maxReplan = tonumber(_G.SMKTMaxReplans) or 2
    local replans = 0
    local finalPos = waypoints[#waypoints]
    local segFrom = hrp.Position
    local lastCheck = 0
    local blockedHits = 0
    local finalArrive = tonumber(_G.SMKTFinalArrive) or 2.5
    local nearFinal = 20
    local jumpEnabled = _G.SMKTJumpRefreshEnabled ~= false
    local jumpInterval = tonumber(_G.SMKTJumpRefreshInterval) or 0.5
    local lastJumpT = os.clock()
    equipCarpet()
    local function hardStop(reason)
        if state.done then return end
        state.done = true
        state.reason = reason or "ok"
        if conn then conn:Disconnect() end
        if hrp and hrp.Parent then vZero(hrp) end
    end
    local function replan()
        if _G.SMKTNoReplan then return false end
        if replans >= maxReplan then return false end
        replans += 1
        local ok, r = pcall(computeRoute, hrp.Position, finalPos)
        if not ok or not r or #r == 0 then return false end
        if (r[1] - hrp.Position).Magnitude < 2 then table.remove(r, 1) end
        if #r == 0 then return false end
        waypoints = r
        wpIdx = 1
        segFrom = hrp.Position
        lastDist = math.huge
        stallT = os.clock()
        blockedHits = 0
        vZero(hrp)
        return true
    end
    conn = RunService.Heartbeat:Connect(function(dt)
        if state.done then return end
        if not isAlive() then _G.TPStatus = "player_died_aborted"; hardStop("died"); return end
        local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
        local pos = hrp.Position
        local target = waypoints[wpIdx]
        local diff = target - pos
        local mag = diff.Magnitude
        local isLast = (wpIdx == #waypoints)
        local arrive = isLast and finalArrive or math.max(3.5, baseSpeed * dt * 1.6)
        local reached = mag < arrive
        if not reached and mag < (isLast and 8 or 16) then
            local seg = target - segFrom
            if seg.Magnitude > 0.5 and (pos - target):Dot(seg.Unit) > 0 then reached = true end
        end
        if reached then
            segFrom = target
            wpIdx += 1
            while wpIdx < #waypoints and (waypoints[wpIdx] - pos).Magnitude < arrive do
                segFrom = waypoints[wpIdx]
                wpIdx += 1
            end
            if wpIdx > #waypoints then hardStop("arrived"); return end
            target = waypoints[wpIdx]; diff = target - pos; mag = diff.Magnitude
            isLast = (wpIdx == #waypoints)
            lastDist = math.huge; stallT = os.clock(); equipCarpet()
        end
        local now = os.clock()
        if now - lastCheck > 0.12 then
            lastCheck = now
            if _G.SMKTLookahead ~= false and wpIdx < #waypoints and _clearWide(pos, waypoints[wpIdx + 1]) then
                segFrom = pos
                wpIdx += 1
                target = waypoints[wpIdx]; diff = target - pos; mag = diff.Magnitude
                isLast = (wpIdx == #waypoints)
                lastDist = math.huge; stallT = now
                blockedHits = 0
            elseif (not isLast or mag > 30) and mag > 6 and _block(pos, target, _blocks) ~= nil then
                blockedHits += 1
                if blockedHits >= 2 then
                    blockedHits = 0
                    if replan() then return end
                end
            else
                blockedHits = 0
            end
        end
        if mag < lastDist - 0.1 then lastDist = mag; stallT = now
        else
            local se = now - stallT
            if se > stallSec then
                if isLast and mag < nearFinal then hardStop("near"); return end
                if replan() then return end
                if (pos - finalPos).Magnitude < nearFinal then hardStop("near"); return end
                _G.TPStatus = "stall_aborted"; hardStop("stall"); return
            end
            if se > repushAt then vZero(hrp); equipCarpet(); stallT = now; lastDist = math.huge end
        end
        if mag >= 0.1 then
            local dir = diff.Unit
            local spd = baseSpeed
            if diff.Y > 2 then spd = math.min(spd, _climbCap() + math.abs(diff.Y)*8) end
            if not isLast and mag < 24 then
                local nxt = waypoints[wpIdx + 1] - target
                if nxt.Magnitude > 0.5 and dir:Dot(nxt.Unit) < 0.6 then
                    spd = math.min(spd, cornerSpd)
                end
            end
            if isLast and mag < 45 then
                local closeSpd = tonumber(CONFIG.CloseSpeed) or 80
                local factor = math.clamp(mag / 45, 0, 1)
                spd = math.max(closeSpd, baseSpeed * factor)
            end
            local isJumpingNow = false
            if jumpEnabled and hum and (now - lastJumpT) >= jumpInterval then
                lastJumpT = now
                isJumpingNow = true
                pcall(function()
                    hum.Jump = true
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end)
            end
            local hDir = Vector3.new(diff.X, 0, diff.Z)
            local hUnit = (hDir.Magnitude > 0.001) and hDir.Unit or Vector3.zero
            local currentY = hrp.AssemblyLinearVelocity.Y
            local yVel
            if diff.Y > 3 then yVel = _climbCap()
            elseif diff.Y < -3 then yVel = math.clamp(diff.Y * 8, -60, 0)
            else
                if isJumpingNow then yVel = 26
                else yVel = math.clamp(currentY, -40, 26) end
            end
            hrp.AssemblyLinearVelocity = Vector3.new(hUnit.X * spd, yVel, hUnit.Z * spd)
            stabilize(hum)
        end
    end)
    return hardStop, state
end

