local draggingMain,dragStart,startPos
Main.InputBegan:Connect(function(i)
	if isInteractingWithSlider then return end
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		draggingMain=true; dragStart=i.Position; startPos=Main.Position end
end)
UserInputService.InputChanged:Connect(function(i)
	if draggingMain and not isInteractingWithSlider and
		(i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
		local delta=i.Position-dragStart
		Main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
	end
end)
UserInputService.InputEnded:Connect(function(i)
	if (i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch) and draggingMain then
		draggingMain=false; Config.GuiPos=Main.Position; SaveConfig() end
end)

UserInputService.InputBegan:Connect(function(input,gpe)
	if gpe then return end
	if waitingTpKey and input.UserInputType==Enum.UserInputType.Keyboard then
		waitingTpKey=false
		local name=input.KeyCode.Name
		if name and name~="Unknown" then
			Config.TpSettings.TpKey=name; TpKeyCode=input.KeyCode
			TpKeyButton.Text=name; TpKeyButton.TextColor3=THEME_TEXT_PRIMARY; SaveConfig()
		else
			TpKeyButton.Text=Config.TpSettings.TpKey or "T"; TpKeyButton.TextColor3=THEME_TEXT_PRIMARY
		end
		return
	end
	if input.UserInputType~=Enum.UserInputType.Keyboard then return end
	if input.KeyCode==TpKeyCode then doVelocityTP() end
end)

if Config.AutoTpOnLoad then
	task.spawn(function()
		local char=LP.Character or LP.CharacterAdded:Wait()
		char:WaitForChild("HumanoidRootPart",5); char:WaitForChild("Humanoid",5)
		task.wait(Config.TpSettings.TpDelay or 0)
		local t0=tick()
		while tick()-t0 < 5 do
			local sel=getPrioritySelected(); local pos=sel and getBrainrotPos(sel)
			if sel and pos then doVelocityTP(); break end
			task.wait(0.1)
		end
	end)
end
