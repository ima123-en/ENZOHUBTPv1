	end

	local char = LP.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then abort("no_char"); return end
	vZero(hrp); stabilize(hum)

	local selData  = getPrioritySelected()
	if not selData then abort("no_priority_selection"); return end
	local brainPos = getBrainrotPos(selData)
	if not brainPos then abort("no_pet_position"); return end

	playPrioritySound()

	local baseIdx  = getBaseIdx(brainPos)
	local isUpper  = brainPos.Y > 7
	if isSecondFloor(brainPos) and Config.TpSettings.TpFloor1WhenFloor2 then isUpper = false end
	local baseEntry = getBaseEntry(baseIdx, isUpper, hrp.Position.Z)
	local destPos   = baseEntry.pos
	local facingDir = baseEntry.look

	local useGrapple = (Config.ToolChoice == "Grapple")
	local baseSpeed  = _pingAdjustSpeed(useGrapple
		and (tonumber(Config.TpSettings.TpGrappleSpeed) or 400)
		or  (tonumber(Config.TpSettings.TpV2Speed)      or 400))
	_G.TPVelocity = baseSpeed

	if checkAbort() then return end

	if useGrapple then
		_G.SMKTIsTeleporting = true
		_G.SMKTFireGrapple(destPos)
		task.wait((tonumber(_G.SMKTGrappleWaitMs) or 200)/1000)
	end
	equipCarpet()

	if checkAbort() then return end
	_G.TPStatus = "traveling_to_base"

	local route
	if isUpper then
		local behindPos = Vector3.new(
			destPos.X - facingDir.X * 12,
			destPos.Y,
			destPos.Z - facingDir.Z * 12
		)
		route = computeRoute(hrp.Position, behindPos, facingDir)
		route[#route + 1] = destPos
	else
		route = computeRoute(hrp.Position, destPos, facingDir)
	end

	local stopMove, mvState = smktVelMove(hrp, route, baseSpeed)
	local t0 = tick()
	local finalArrive = tonumber(_G.SMKTFinalArrive) or 2.5
	while tick()-t0 < 10 do
		if checkAbort() then stopMove(); return end
		if mvState.done then break end
		if (hrp.Position-destPos).Magnitude < finalArrive then break end
		stabilize(hum); task.wait(0.02)
	end
	stopMove()

	local snapRange = tonumber(_G.SMKTSnapRange) or 25
	if _G.TPStatus == "stall_aborted" and (hrp.Position-destPos).Magnitude <= snapRange then
		_G.TPStatus = "traveling_to_base"
	end
	if checkAbort() then return end
	if (hrp.Position-destPos).Magnitude > snapRange then abort("base_not_reached"); return end

	_G.TPStatus = "at_base_fixing_position"

	prepCloner()
	local function faceCF(p) return CFrame.lookAt(p, p + facingDir) end
	pcall(function() hum.AutoRotate = false end)
	vZero(hrp)
	hrp.CFrame = faceCF(destPos)

	local holdT = tonumber(_G.SMKTFixHoldTime) or 0.12
	local tHold = os.clock()
	while os.clock() - tHold < holdT do
		if checkAbort() then return end
		hrp.CFrame = faceCF(destPos)
		vZero(hrp)
		stabilize(hum)
		RunService.Heartbeat:Wait()
	end

	if _G.SMKTFixJump ~= false then
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
			hum.Jump = true
		end)
	end

	local leftDir  = Vector3.new(0, 1, 0):Cross(facingDir)
	if leftDir.Magnitude < 0.01 then leftDir = Vector3.new(0, 0, 1) end
	leftDir = leftDir.Unit
	local driftSpd = tonumber(_G.SMKTFixDriftSpeed) or 6
	local driftT   = tonumber(_G.SMKTFixDriftTime) or 0.3
	local tDrift   = os.clock()
	while os.clock() - tDrift < driftT do
		if checkAbort() then return end
		local vy = hrp.AssemblyLinearVelocity.Y
		hrp.AssemblyLinearVelocity  = leftDir * driftSpd + Vector3.new(0, vy, 0)
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = faceCF(hrp.Position)
		stabilizeSoft(hum)
		RunService.Heartbeat:Wait()
	end
	hrp.AssemblyLinearVelocity  = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = faceCF(hrp.Position)
	pcall(function() hum.AutoRotate = true end)

	if checkAbort() then return end
	if (hrp.Position-destPos).Magnitude > 12 then abort("base_not_reached"); return end

	_G.TPStatus = "cloning"
	task.wait(math.clamp(Config.TpSettings.CloneDelay or 0.03, 0.01, 1))
	if checkAbort() then return end

	local cloneOk = doClone(destPos)
	if checkAbort() then return end

	if cloneOk then
		_G.TPStatus = "post_clone_stabilize"
		char = LP.Character
		hrp  = char and char:FindFirstChild("HumanoidRootPart")
		hum  = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp then abort("no_char_after_swap"); return end
		vZero(hrp); stabilize(hum); equipCarpet()
		task.wait(math.max(0.05, tonumber(_G.SMKTPostCloneDelay) or 0.1))
		if checkAbort() then return end
		_G.TPStatus = "going_to_brainrot"
		goToBrainrot(brainPos, selData)
		if _G.TPStatus ~= "lagback_detected_aborted"
			and _G.TPStatus ~= "player_died_aborted"
			and _G.TPStatus ~= "stall_aborted" then
			_G.TPStatus = "done"
		end
	else
		abort("clone_failed"); return
	end
end

local function doVelocityTP()
	if isTeleporting then
		local wd = tonumber(_G.SMKTTPWatchdog) or 25
		if os.clock() - _tpStartT < wd then return end
		_resetTPFlags()
	end
	isTeleporting = true
	_G.SMKTIsTeleporting = true
	_tpStartT = os.clock()
	local ok, err = pcall(_doVelocityTPInner)
	if not ok then
		warn("[SMKTHub] TP error: " .. tostring(err))
		_G.TPStatus = "error_aborted"
	end
	_resetTPFlags()
end

