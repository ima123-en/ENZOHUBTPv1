local function updateGuiBox(v) GuiBox.Text=tostring(math.floor(v)).."%"end
local function setGuiAlpha(a,instant)
	a=math.clamp(a,0,1)
	local value=math.floor(1+(100-1)*a+0.5); Config.GuiScale=value
	local len=GuiBar.AbsoluteSize.X
	if len>0 then
		local px=a*len
		if instant then GuiFill.Size=UDim2.new(0,px,1,0); GuiKnob.Position=UDim2.new(0,px-5,0.5,-5)
		else
			TweenService:Create(GuiFill,TweenInfo.new(0.1),{Size=UDim2.new(0,px,1,0)}):Play()
			TweenService:Create(GuiKnob,TweenInfo.new(0.1),{Position=UDim2.new(0,px-5,0.5,-5)}):Play()
		end
	end
	local scale=0.3+(1.0-0.3)*((value-1)/(100-1))
	if instant then GlobalUIScale.Scale=scale
	else TweenService:Create(GlobalUIScale,TweenInfo.new(0.15),{Scale=scale}):Play() end
	updateGuiBox(value); SaveConfig()
end
local function updateGuiX(px)
	local len=GuiBar.AbsoluteSize.X; if len<=0 then return end
	setGuiAlpha((px-GuiBar.AbsolutePosition.X)/len,false)
end
