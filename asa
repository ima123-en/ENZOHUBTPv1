local function doClone()
    local char = LP.Character or LP.CharacterAdded:Wait()
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return false end
    local cloner = getCloner()
    if not cloner then
        local _tc0 = os.clock()
        while not cloner and os.clock() - _tc0 < 2.5 do
            if _G.TacoTPStop then return false end
            RunService.Heartbeat:Wait()
            char = LP.Character or char
            cloner = (LP:FindFirstChild("Backpack") and LP.Backpack:FindFirstChild("Quantum Cloner"))
                or (char and char:FindFirstChild("Quantum Cloner"))
        end
        if not cloner then return false end
        hum = char and char:FindFirstChildOfClass("Humanoid") or hum
        if not hum then return false end
    end
    local _preArmed = false
    do
        local pg0 = LP:FindFirstChild("PlayerGui")
        local tf0 = pg0 and pg0:FindFirstChild("ToolsFrames")
        local qc0 = tf0 and tf0:FindFirstChild("QuantumCloner")
        local tb0 = qc0 and qc0:FindFirstChild("TeleportToClone")
        _preArmed = (cloner.Parent == char) and (tb0 ~= nil)
    end
    if not _preArmed then
        if cloner.Parent ~= char then pcall(function() hum:EquipTool(cloner) end); task.wait() end
        pcall(function() hum:UnequipTools() end)
        task.wait()
        if cloner.Parent ~= char then pcall(function() hum:EquipTool(cloner) end); task.wait() end
    end
    local pg = LP:FindFirstChild("PlayerGui")
    local tb
    do
        local _tb0 = os.clock()
        repeat
            pg = LP:FindFirstChild("PlayerGui")
            local tf = pg and pg:FindFirstChild("ToolsFrames")
            local qc = tf and tf:FindFirstChild("QuantumCloner")
            tb = qc and qc:FindFirstChild("TeleportToClone")
            if tb then break end
            RunService.Heartbeat:Wait()
        until os.clock() - _tb0 > 1.2
    end
    _G.isCloning = true
    pcall(function() cloner:Activate() end)
    task.wait(0.05)
    local fired = false
    if tb then
        pcall(function() tb.Visible = true end)
        if typeof(firesignal) == "function" then
            local ok = pcall(function()
                firesignal(tb.MouseButton1Click)
                firesignal(tb.MouseButton1Up)
                firesignal(tb.Activated)
            end)
            fired = ok
        end
    end
    if not fired then
        local remote = getQuantumTeleportRemote()
        if remote then pcall(function() remote:FireServer() end); fired = true end
    end
    task.delay(0.55, function() _G.isCloning = false end)
    return fired
end

local function goToBrainrot(brainPos, selRef)
    if not brainPos then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    equipCarpet()
    vZero(hrp)
    stabilize(hum)
    _G.SMKTNoReplan = true
    _G.SMKTLookahead = false
    local _prevDirect = _G.SMKTDirect
    _G.SMKTDirect = false
    char = LP.Character
    local hrp2 = char and char:FindFirstChild("HumanoidRootPart")
    if hrp2 then hrp = hrp2 end
    local hum2 = char and char:FindFirstChildOfClass("Humanoid")
    if hum2 then hum = hum2 end
    local needsHover = (brainPos.Y > 20)
        or (brainPos.Y >= 8.0 and brainPos.Y <= 11.0 and CONFIG.TpFloor1WhenFloor2)
    local targetPos
    if brainPos.Y > 20 then
        targetPos = Vector3.new(brainPos.X, brainPos.Y - 5, brainPos.Z)
    elseif brainPos.Y >= 8.0 and brainPos.Y <= 11.0 and CONFIG.TpFloor1WhenFloor2 then
        targetPos = Vector3.new(brainPos.X, brainPos.Y - 7, brainPos.Z)
    else
        local look = hrp.CFrame.LookVector
        targetPos = Vector3.new((brainPos - look * 3).X, hrp.Position.Y, (brainPos - look * 3).Z)
    end
    local _gtbSpeedMult = 1.0
    local _gtbLastPos = hrp.Position
    local _gtbLastT = os.clock()
    local _gtbCurrentSpeed = _pingAdjustSpeed(tonumber(CONFIG.WalkToBrainrotSpd) or 200)
    local _gtbLagConn
    _gtbLagConn = RunService.Heartbeat:Connect(function()
        local c2 = LP.Character
        local h2 = c2 and c2:FindFirstChild("HumanoidRootPart")
        if not h2 then return end
        local now = os.clock()
        local pos2 = h2.Position
        if (now - _gtbLastT) > 0.1 then
            local moved = (pos2 - _gtbLastPos).Magnitude
            local vel = h2.AssemblyLinearVelocity.Magnitude
            if moved > 8 and vel < 8 then
                _gtbSpeedMult = math.max(0.3, _gtbSpeedMult * 0.90)
                _gtbCurrentSpeed = math.floor(_pingAdjustSpeed(tonumber(CONFIG.WalkToBrainrotSpd) or 200) * _gtbSpeedMult)
                _G.SMKTGoSpeed = _gtbCurrentSpeed
                _G.SMKTBrainrotSpeed = _gtbCurrentSpeed
            end
            _gtbLastPos = pos2
            _gtbLastT = now
        end
    end)
    local stopMove, mvState = smktVelMove(hrp, { targetPos }, _gtbCurrentSpeed)
    local t0 = tick()
    while tick() - t0 < 8 do
        if not isAlive() then break end
        if _G.TPStatus == "lagback_detected_aborted" then break end
        if mvState.done then break end
        if (hrp.Position - targetPos).Magnitude < 3 then break end
        if _gtbCurrentSpeed ~= (tonumber(CONFIG.WalkToBrainrotSpd) or 200) then
            stopMove()
            if not isAlive() then break end
            local c2 = LP.Character
            local h2 = c2 and c2:FindFirstChild("HumanoidRootPart")
            if not h2 then break end
            hrp = h2
            stopMove, mvState = smktVelMove(hrp, { targetPos }, _gtbCurrentSpeed)
        end
        stabilize(hum)
        task.wait(0.02)
    end
    stopMove()
    if _gtbLagConn then _gtbLagConn:Disconnect() end
    vZero(hrp)
    _G.SMKTNoReplan = false
    _G.SMKTLookahead = true
    _G.SMKTDirect = _prevDirect
    if not needsHover then
        for _ = 1, 2 do
            if not isAlive() then return end
            if LP:GetAttribute("Stealing") then return end
            local c = LP.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if not h then return end
            equipCarpet()
            vZero(h)
            local cf = h.CFrame
            h.CFrame = CFrame.new(targetPos + Vector3.new(0, 0.5, 0)) *
                CFrame.fromMatrix(Vector3.zero, cf.RightVector, cf.UpVector, cf.LookVector)
            vZero(h)
            stabilize(hum)
            task.wait(0.3)
        end
        return
    end
    local freezePos = targetPos + Vector3.new(0, 1.5, 0)
    local maxHoverTime = 25
    local t0_hover = os.clock()
    local holdGain = 8
    local maxHoldSpeed = 60
    local snapDist = 0.2
    local moveThresh = 0.1
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local c = LP.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        local hm = c and c:FindFirstChildOfClass("Humanoid")
        if not h or not hm or hm.Health <= 0 then
            if conn then conn:Disconnect() end
            return
        end
        if LP:GetAttribute("Stealing") then
            if conn then conn:Disconnect() end
            return
        end
        if hm.MoveDirection.Magnitude > moveThresh then
            if conn then conn:Disconnect() end
            return
        end
        local offset = freezePos - h.Position
        local dist = offset.Magnitude
        if dist > snapDist then
            local spd = math.min(dist * holdGain, maxHoldSpeed)
            h.AssemblyLinearVelocity = offset.Unit * spd
        else
            h.AssemblyLinearVelocity = Vector3.zero
        end
        h.AssemblyAngularVelocity = Vector3.zero
        stabilize(hm)
        equipCarpet()
        local stolen = false
        if selRef and selRef.model and not selRef.model.Parent then stolen = true end
        if not getPrioritySelected() then stolen = true end
        if stolen or (os.clock() - t0_hover) > maxHoverTime or dist > 35 then
            if conn then conn:Disconnect() end
        end
    end)
end

