local function isAlive()
	local char = LP.Character
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	return char and hum and hrp and hum.Health > 0 and hrp.Parent == char
end

local function findTool(name)
	local char = LP.Character
	local bp   = LP:FindFirstChild("Backpack") or LP:FindFirstChildOfClass("Backpack")
	return (char and char:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
end

local function equipCarpet()
	local char = LP.Character
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end
	for _, n in ipairs(CARPET_NAMES) do
		local t = findTool(n)
		if t and t:IsA("Tool") then
			if t.Parent ~= char then pcall(function() hum:EquipTool(t) end) end
			return n
		end
	end
	return nil
end

local function vZero(hrp)
	if not hrp then return end
	pcall(function()
		hrp.AssemblyLinearVelocity  = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.Velocity    = Vector3.zero
		hrp.RotVelocity = Vector3.zero
	end)
end

local function stabilize(hum)
	if not hum or hum.Health <= 0 then return end
	pcall(function()
		hum.PlatformStand = false
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
		local s = hum:GetState()
		if s == Enum.HumanoidStateType.FallingDown
			or s == Enum.HumanoidStateType.Ragdoll
			or s == Enum.HumanoidStateType.PlatformStanding
			or s == Enum.HumanoidStateType.Freefall then
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end
	end)
end

local function _muteAndStopPull(tool, hrp)
	if tool then
		for _, s in ipairs(tool:GetDescendants()) do
			if s:IsA("Sound") then
				pcall(function() s.Volume = 0; s:Stop() end)
			elseif s:IsA("Beam") then
				pcall(function() s.Enabled = false; s.Attachment0 = nil end)
			end
		end
	end
	if hrp then
		local fp = hrp:FindFirstChild("FlightPower")
		if fp then fp:Destroy() end
		if not _G.SabcomIsTeleporting then
			pcall(function()
				hrp.AssemblyLinearVelocity  = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end)
		end
	end
end

local function _holdNoPull(tool, hrp, seconds)
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		_muteAndStopPull(tool, hrp)
		if os.clock() - t0 > seconds then
			conn:Disconnect()
			_muteAndStopPull(tool, hrp)
		end
	end)
end

_G.__SabcomGrappleDisparar = function(tool, pos, alvo, char, RSv)
	local refs = (getgenv and getgenv().__SabcomPMRefs) or _G.__SabcomPMRefs
	if not refs then
		refs = {}
		pcall(function()
			local mouse = require((RSv or ReplicatedStorage).Packages.PlayerMouse)
			if type(mouse) == "table" then refs[1] = mouse end
		end)
		if getgenv then getgenv().__SabcomPMRefs = refs end
		_G.__SabcomPMRefs = refs
	end
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	_muteAndStopPull(tool, hrp)
	local mira  = CFrame.new(pos)
	local antes = {}
	for i, t in ipairs(refs) do
		antes[i] = { rawget(t,"Hit"), rawget(t,"Target") }
		pcall(function() t.Hit = mira; t.Target = alvo end)
	end
	local ok = pcall(function() tool:Activate() end)
	if not ok then ok = pcall(function() firesignal(tool.Activated) end) end
	_muteAndStopPull(tool, hrp)
	_holdNoPull(tool, hrp, 0.6)
	task.spawn(function()
		for _ = 1, 4 do
			for _, t in ipairs(refs) do
				pcall(function() t.Hit = mira; t.Target = alvo end)
			end
			_muteAndStopPull(tool, hrp)
			RunService.Heartbeat:Wait()
		end
		for i, t in ipairs(refs) do
			local a = antes[i]
			pcall(function() t.Hit = a[1]; t.Target = a[2] end)
		end
		_muteAndStopPull(tool, hrp)
	end)
	return ok
end

_G.SabcomFireGrapple2 = function(value, exato)
	local eu   = Players.LocalPlayer
	local char = eu and eu.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	if eu:GetAttribute("Stealing") then return false end

	local tool = char:FindFirstChild("Grapple Hook")
	if not tool then
		local bp  = eu:FindFirstChildOfClass("Backpack")
		local t2  = bp and bp:FindFirstChild("Grapple Hook")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not t2 or not hum then return false end
		pcall(function() hum:EquipTool(t2) end)
		local t0 = os.clock()
		repeat
			RunService.Heartbeat:Wait()
			char = eu.Character
			tool = char and char:FindFirstChild("Grapple Hook")
		until tool or os.clock() - t0 > 0.5
		if not tool then return false end
		hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end
	end

	local par0 = RaycastParams.new()
	par0.FilterType = Enum.RaycastFilterType.Exclude
	par0.FilterDescendantsInstances = { char }

	if exato and typeof(value) == "Vector3" then
		local pos = value
		local m = (pos - hrp.Position).Magnitude
		if m < 10 or m > 50 then return false end
		local alvo
		local hit = workspace:Raycast(hrp.Position, pos - hrp.Position, par0)
		if hit then alvo = hit.Instance end
		if not alvo then
			for _, p in ipairs(workspace:GetPartBoundsInRadius(pos, 6)) do
				if p:IsA("BasePart") and not p:IsDescendantOf(char) then alvo = p; break end
			end
		end
		if not alvo then return false end
		return _G.__SabcomGrappleDisparar(tool, pos, alvo, char, ReplicatedStorage)
	end

	local destino
	if typeof(value) == "Vector3" then destino = value
	elseif typeof(value) == "Instance" and value:IsA("BasePart") then destino = value.Position end

	local dir
	if destino then
		dir = destino - hrp.Position
		dir = Vector3.new(dir.X, 0, dir.Z)
	end
	if not dir or dir.Magnitude < 1 then
		local lv = hrp.CFrame.LookVector
		dir = Vector3.new(lv.X, 0, lv.Z)
	end
	if dir.Magnitude < 0.01 then return false end
	dir = dir.Unit

	local par = RaycastParams.new()
	par.FilterType = Enum.RaycastFilterType.Exclude
	par.FilterDescendantsInstances = { char }

	local pos, alvo, melhorM
	for _, d in ipairs({ 9,10,11,12,13,14,16,18,21,24,28,32,36,40,45 }) do
		local origem = hrp.Position + dir * d + Vector3.new(0, 3, 0)
		local hit = workspace:Raycast(origem, Vector3.new(0,-60,0), par)
		if hit then
			local m = (hit.Position - hrp.Position).Magnitude
			if m >= 10 and m <= 50 and (not melhorM or m < melhorM) then
				pos, alvo, melhorM = hit.Position, hit.Instance, m
			end
		end
	end
	if not pos then
		for _, d in ipairs({ 11,14,18,24,32,42,48 }) do
			local hit = workspace:Raycast(hrp.Position, dir * d, par)
			if hit then
				local m = (hit.Position - hrp.Position).Magnitude
				if m >= 10 and m <= 50 and (not melhorM or m < melhorM) then
					pos, alvo, melhorM = hit.Position, hit.Instance, m
				end
			end
		end
	end
	if not pos or not alvo then return false end
	return _G.__SabcomGrappleDisparar(tool, pos, alvo, char, ReplicatedStorage)
end

local function _pingMs()
	local ok, v = pcall(function()
		return Players.LocalPlayer:GetNetworkPing() * 1000
	end)
	return ok and v or 80
end

local function _pingAdjustSpeed(baseSpeed)
	local ping   = _pingMs()
	local thresh = tonumber(_G.SabcomPingThresh) or 170
	if ping > thresh then
		return math.min(baseSpeed, tonumber(_G.SabcomHighPingSpeed) or 400)
	end
	return baseSpeed
end

local function _clearWide(from, to, radius)
	radius = radius or (tonumber(_G.SabcomPathRadius) or 2.5)
	local dir  = to - from
	local dist = dir.Magnitude
	if dist < 0.1 then return true end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local char = LP.Character
	rp.FilterDescendantsInstances = char and { char } or {}
	local offsets = {
		Vector3.zero,
		Vector3.new( radius, 0, 0), Vector3.new(-radius, 0, 0),
		Vector3.new(0, 0,  radius), Vector3.new(0, 0, -radius),
		Vector3.new(0,  radius*0.5, 0),
	}
	for _, off in ipairs(offsets) do
		local origin = from + off
		local hit = workspace:Raycast(origin, dir.Unit * dist, rp)
		if hit then
			local inst = hit.Instance
			local skip = false
			if inst then
				if not inst.CanCollide then skip = true end
				if not inst.Anchored then skip = true end
				local nm = (inst.Name or ""):lower()
				if nm:find("terrain") or nm:find("baseplate") then skip = false end
				if nm:find("clone") or nm:find("pet") or nm:find("animal") then skip = true end
				if inst:IsDescendantOf(workspace.Terrain) then skip = false end
			end
			if not skip then return false end
		end
	end
	return true
end

local function voxelRoute(startPos, endPos, up)
	local cell   = tonumber(_G.SabcomPathCell)   or 4
	local radius = tonumber(_G.SabcomPathRadius) or 2.5
	local height = tonumber(_G.SabcomPathHeight) or 5
	up = up or 0

	local function snap(p)
		return Vector3.new(
			math.floor(p.X/cell+0.5)*cell,
			math.floor(p.Y/cell+0.5)*cell,
			math.floor(p.Z/cell+0.5)*cell
		)
	end

	local function heur(a, b)
		local d = b - a
		return math.abs(d.X) + math.abs(d.Y)*1.5 + math.abs(d.Z)
	end

	local function blocked(p)
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		local char = LP.Character
		rp.FilterDescendantsInstances = char and { char } or {}
		local dirs6 = {
			Vector3.new(1,0,0)*radius,  Vector3.new(-1,0,0)*radius,
			Vector3.new(0,0,1)*radius,  Vector3.new(0,0,-1)*radius,
			Vector3.new(0,1,0)*height,  Vector3.new(0,-1,0)*height,
		}
		for _, d in ipairs(dirs6) do
			local hit = workspace:Raycast(p, d, rp)
			if hit and hit.Instance and hit.Instance.CanCollide and hit.Instance.Anchored then
				local nm = (hit.Instance.Name or ""):lower()
				if not nm:find("clone") and not nm:find("pet") and not nm:find("animal") then
					return true
				end
			end
		end
		return false
	end

	local sSnap = snap(startPos)
	local eSnap = snap(endPos)

	if _clearWide(startPos, endPos, radius) then
		return { startPos, endPos }
	end

	local DIRS = {
		Vector3.new(1,0,0), Vector3.new(-1,0,0),
		Vector3.new(0,0,1), Vector3.new(0,0,-1),
		Vector3.new(0,1,0), Vector3.new(0,-1,0),
		Vector3.new(1,0,1).Unit,  Vector3.new(-1,0,1).Unit,
		Vector3.new(1,0,-1).Unit, Vector3.new(-1,0,-1).Unit,
		Vector3.new(1,1,0).Unit,  Vector3.new(-1,1,0).Unit,
		Vector3.new(0,1,1).Unit,  Vector3.new(0,1,-1).Unit,
	}

	local open   = {}
	local closed = {}
	local gScore = {}
	local parent = {}

	local startKey = sSnap.X.."_"..sSnap.Y.."_"..sSnap.Z
	gScore[startKey] = 0
	table.insert(open, { pos = sSnap, f = heur(sSnap, eSnap), g = 0 })

	local best, bestDist = sSnap, (sSnap - eSnap).Magnitude
	local iters   = 0
	local maxIter = 600

	while #open > 0 and iters < maxIter do
		iters = iters + 1
		table.sort(open, function(a,b) return a.f < b.f end)
		local cur = table.remove(open, 1)
		local cp  = cur.pos
		local ck  = cp.X.."_"..cp.Y.."_"..cp.Z
		if closed[ck] then continue end
		closed[ck] = true
		local d = (cp - eSnap).Magnitude
		if d < bestDist then bestDist = d; best = cp end
		if d < cell * 1.5 or _clearWide(cp, endPos, radius) then best = cp; break end
		for _, dir in ipairs(DIRS) do
			local nb  = snap(cp + dir * cell)
			local nk  = nb.X.."_"..nb.Y.."_"..nb.Z
			if closed[nk] then continue end
			local yDiff = nb.Y - startPos.Y
			if yDiff < -4 or yDiff > (up > 0 and up+8 or 40) then continue end
			if blocked(nb) then continue end
			local ng = cur.g + (dir * cell).Magnitude
			if not gScore[nk] or ng < gScore[nk] then
				gScore[nk] = ng
				parent[nk] = ck
				parent[nk.."_pos"] = nb
				parent[ck.."_pos"] = cp
				table.insert(open, { pos = nb, f = ng + heur(nb, eSnap), g = ng })
			end
		end
	end

	local path  = {}
	local cur   = best
	local ck    = cur.X.."_"..cur.Y.."_"..cur.Z
	local limit = 300
	while ck and limit > 0 do
		limit = limit - 1
		table.insert(path, 1, cur)
		local pk = parent[ck]
		if not pk then break end
		cur = parent[pk.."_pos"]
		if not cur then break end
		ck = pk
	end

	if #path == 0 then
		path = { startPos, endPos }
	else
		path[1]       = startPos
		path[#path+1] = endPos
	end

	local smooth = { path[1] }
	local i = 1
	while i < #path do
		local nextVis = i + 1
		for j = #path, i+2, -1 do
			if _clearWide(smooth[#smooth], path[j], radius) then nextVis = j; break end
		end
		table.insert(smooth, path[nextVis])
		i = nextVis
	end

	return smooth
end

local function computeRoute(startPos, targetPos, facingDir, upHint)
	if _G.SabcomDirect ~= false and _clearWide(startPos, targetPos, tonumber(_G.SabcomPathRadius) or 2.5) then
		return { startPos, targetPos }
	end
	return voxelRoute(startPos, targetPos, upHint)
end

local function _climbCap(hrp, targetY)
	if _G.SabcomClimbFull == true then return tonumber(_G.SabcomClimb) or 160 end
	local diff = targetY - hrp.Position.Y
	if diff > 2 then
		local safe = tonumber(_G.SabcomClimbSafe) or 250
		local full = tonumber(_G.SabcomClimb) or 160
		return diff > 8 and full or safe
	end
	return tonumber(_G.SabcomClimb) or 160
end

local function sabcomVelMove(hrp, waypoints, speedOverride)
	if not hrp or not hrp.Parent or #waypoints == 0 then return function() end end
	local done      = false
	local wpIdx     = 1
	local conn
	local ARRIVE    = 3.5
	local stallSec  = tonumber(_G.SabcomStallSec) or 0.6
	local repushAt  = tonumber(_G.SabcomRepushAt) or 0.9
	local lastDist  = math.huge
	local stallT    = os.clock()
	local baseSpeed = _pingAdjustSpeed(speedOverride or tonumber(_G.TPVelocity) or 400)
	equipCarpet()
	local function hardStop()
		if done then return end
		done = true
		if conn then conn:Disconnect() end
		if hrp and hrp.Parent then vZero(hrp) end
	end
	conn = RunService.Heartbeat:Connect(function()
		if done then return end
		if not isAlive() then _G.TPStatus = "player_died_aborted"; hardStop(); return end
		local target = waypoints[wpIdx]
		local diff   = target - hrp.Position
		local mag    = diff.Magnitude
		if mag < lastDist - 0.1 then lastDist = mag; stallT = os.clock()
		else
			local se = os.clock() - stallT
			if se > repushAt then vZero(hrp); equipCarpet(); stallT = os.clock(); lastDist = math.huge end
			if se > stallSec then _G.TPStatus = "stall_aborted"; hardStop(); return end
		end
		if mag < ARRIVE then
			wpIdx = wpIdx + 1
			if wpIdx > #waypoints then hardStop(); return end
			target = waypoints[wpIdx]; diff = target - hrp.Position; mag = diff.Magnitude
			lastDist = math.huge; stallT = os.clock(); equipCarpet()
		end
		if mag >= 0.1 then
			local dir = diff.Unit
			local spd = baseSpeed
			if diff.Y > 2 then spd = math.min(spd, _climbCap(hrp, target.Y) + math.abs(diff.Y)*8) end
			if wpIdx == #waypoints and mag < 12 then
				spd = math.max(tonumber(_G.SabcomCloseSpeed) or 80, spd * (mag/12))
			end
			hrp.AssemblyLinearVelocity = dir * spd
			stabilize(hrp.Parent:FindFirstChildOfClass("Humanoid"))
		end
	end)
	return hardStop
end

