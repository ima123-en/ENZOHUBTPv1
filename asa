	local idNum = (Config.TpSettings.PrioritySoundID or "94302001673909"):match("%d+")
	if not idNum then return end
	local s = Instance.new("Sound")
	s.SoundId="rbxassetid://"..idNum; s.Volume=1; s.Parent=SoundService; s:Play()
	game:GetService("Debris"):AddItem(s, 6)
end

local isTeleporting = false
_G.TPStatus = "idle"

local function doVelocityTP()
	if isTeleporting then return end
	isTeleporting = true
	_G.SMKTIsTeleporting = true
	_G.TPStatus = "start"

	local function abort(reason)
		_G.TPStatus = reason or "aborted"
		isTeleporting = false
		_G.SMKTIsTeleporting = false
	end
	local function checkAbort()
		if not isAlive() then abort("player_died_aborted"); return true end
		if _G.TPStatus == "lagback_detected_aborted" then abort("lagback_detected_aborted"); return true end
		if _G.TPStatus == "stall_aborted" then abort("stall_aborted"); return true end
		return false
	end

	local char = LP.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then abort("no_char"); return end
	vZero(hrp); stabilize(hum)

	local selData  = getPrioritySelected()
	if not selData then abort("no_priority_selection"); return end
	local brainPos = getBrainrotPos(selData)
	if not brainPos then abort("no_pet_position"); return end

	playPrioritySound()

	local baseIdx  = getBaseIdx(brainPos)
	local isUpper  = brainPos.Y > 7
	if isSecondFloor(brainPos) and Config.TpSettings.TpFloor1WhenFloor2 then isUpper = false end
	local baseEntry = getBaseEntry(baseIdx, isUpper, hrp.Position.Z)
	local destPos   = baseEntry.pos
	local facingDir = baseEntry.look

	local useGrapple = (Config.ToolChoice == "Grapple")
	local baseSpeed  = _pingAdjustSpeed(useGrapple
		and (tonumber(Config.TpSettings.TpGrappleSpeed) or 400)
		or  (tonumber(Config.TpSettings.TpV2Speed)      or 400))
	_G.TPVelocity = baseSpeed

	if checkAbort() then return end

	if useGrapple then
		_G.SMKTIsTeleporting = true
		_G.SMKTFireGrapple(destPos)
		task.wait((tonumber(_G.SMKTGrappleWaitMs) or 200)/1000)
	end
	equipCarpet()

	if checkAbort() then return end
	_G.TPStatus = "traveling_to_base"

	local route
	if isUpper then
		local behindPos = Vector3.new(
			destPos.X - facingDir.X * 12,
			destPos.Y,
			destPos.Z - facingDir.Z * 12
		)
		route = { hrp.Position, behindPos, destPos }
	else
		route = computeRoute(hrp.Position, destPos, facingDir)
	end

	local stopMove = smktVelMove(hrp, route, baseSpeed)
	local t0       = tick()
	while tick()-t0 < 10 do
		if checkAbort() then stopMove(); return end
		if (hrp.Position-destPos).Magnitude < 4 then break end
		stabilize(hum); task.wait(0.02)
	end
	stopMove()

	if checkAbort() then return end
	_G.TPStatus = "at_base_fixing_position"

	vZero(hrp); hrp.Anchored=true; hrp.CFrame=CFrame.new(destPos, destPos+facingDir)
	local fixFrames = 8
	local fixConn
	fixConn = RunService.Heartbeat:Connect(function()
		if fixFrames <= 0 then
			fixConn:Disconnect()
			if hrp and hrp.Parent then hrp.Anchored=false; vZero(hrp) end
			return
		end
		fixFrames = fixFrames - 1
		if hrp and hrp.Parent then hrp.CFrame=CFrame.new(destPos,destPos+facingDir); vZero(hrp) end
	end)
	task.wait(0.15)

	if checkAbort() then return end
	if (hrp.Position-destPos).Magnitude > 12 then abort("base_not_reached"); return end

	_G.TPStatus = "cloning"
	task.wait(math.clamp(Config.TpSettings.CloneDelay or 0.03, 0.01, 1))
	if checkAbort() then return end

	local cloneOk = doClone()
	if checkAbort() then return end

	if cloneOk then
		_G.TPStatus = "post_clone_stabilize"

		local cloneName  = tostring(LP.UserId) .. "_Clone"
		local prePos     = hrp.Position
		local swapTimeout = tick()
		repeat
			task.wait(0.03)
			if checkAbort() then return end
			char = LP.Character
			hrp  = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then break end
		until not Workspace:FindFirstChild(cloneName, true)
			or (hrp.Position - prePos).Magnitude > 3
			or tick() - swapTimeout > 1.2

		_G.TPStatus = "post_clone_stabilize"

		char = LP.Character
		hrp  = char and char:FindFirstChild("HumanoidRootPart")
		hum  = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp then abort("no_char_after_swap"); return end

		vZero(hrp); stabilize(hum); equipCarpet()
		task.wait(math.max(0.05, tonumber(_G.SMKTPostCloneDelay) or 0.1))

		if checkAbort() then return end

		_G.TPStatus = "going_to_brainrot"
		goToBrainrot(brainPos, selData)

		if _G.TPStatus ~= "lagback_detected_aborted"
			and _G.TPStatus ~= "player_died_aborted"
			and _G.TPStatus ~= "stall_aborted" then
			_G.TPStatus = "done"
		end
	else
		abort("clone_failed"); return
