local function _atomicWrite(path, content)
	if not writefile then return false end
	local tmpPath = path .. ".tmp"
	local ok1 = pcall(writefile, tmpPath, content)
	if not ok1 then return false end
	if readfile then
		local ok2, verify = pcall(readfile, tmpPath)
		if not ok2 or verify ~= content then
			pcall(function() if delfile then delfile(tmpPath) end end)
			return false
		end
	end
	local ok3 = pcall(writefile, path, content)
	pcall(function() if delfile then delfile(tmpPath) end end)
	return ok3
end

local function SaveConfigNow()
	if not writefile then return end
	local data = _buildSaveData()
	local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
	if not ok or type(encoded) ~= "string" then return end
	_atomicWrite(SAVE_KEY .. ".json", encoded)
end

local _saveQueued  = false
local _saveDirty   = false
local function SaveConfig()
	if not writefile then return end
	_saveDirty = true
	if _saveQueued then return end
	_saveQueued = true
	task.delay(0.35, function()
		_saveQueued = false
		if _saveDirty then SaveConfigNow() end
	end)
end

local function LoadConfig()
	if not (readfile and isfile) then return end
	local ok, exists = pcall(isfile, SAVE_KEY .. ".json")
	if not ok or not exists then return end
	local okRead, raw = pcall(readfile, SAVE_KEY .. ".json")
	if not okRead or type(raw) ~= "string" or #raw == 0 then return end
	local okDecode, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not okDecode or type(data) ~= "table" then
		warn("[SMKTHub] Config corrupted, resetting to defaults.")
		return
	end
	if type(data.TpSettings) == "table" then
		for k, def in pairs(_defaultTpSettings) do
			local v = data.TpSettings[k]
			if v ~= nil and type(v) == type(def) then
				Config.TpSettings[k] = v
			end
		end
	end
	if type(data.AutoTpOnLoad) == "boolean" then Config.AutoTpOnLoad = data.AutoTpOnLoad end
	if type(data.GuiScale) == "number" then
		Config.GuiScale = math.clamp(data.GuiScale, 1, 100)
	end
	if type(data.ToolChoice) == "string" and REAL_TOOL_NAMES[data.ToolChoice] then
		Config.ToolChoice = data.ToolChoice
	end
	if type(data.GuiPos) == "table" and type(data.GuiPos.ScaleX) == "number" then
		local gp = data.GuiPos
		Config.GuiPos = UDim2.new(gp.ScaleX or 1, gp.OffsetX or 0, gp.ScaleY or 0, gp.OffsetY or 0)
	end
end

