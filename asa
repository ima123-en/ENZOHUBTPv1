	local function getOwnerVisual(plot)
		local sign=plot:FindFirstChild("PlotSign"); if not sign then return "?" end
		local gui=sign:FindFirstChildWhichIsA("SurfaceGui",true)
		if gui then
			for _,lbl in ipairs(gui:GetDescendants()) do
