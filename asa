local function LoadConfig()
	pcall(function()
		if readfile and isfile and isfile(SAVE_KEY .. ".json") then
			local data = HttpService:JSONDecode(readfile(SAVE_KEY .. ".json"))
			if data.TpSettings then
				for k,v in pairs(data.TpSettings) do Config.TpSettings[k] = v end
			end
			if data.AutoTpOnLoad ~= nil then Config.AutoTpOnLoad = data.AutoTpOnLoad end
			if data.GuiScale    ~= nil then Config.GuiScale    = data.GuiScale end
			if data.ToolChoice  ~= nil then Config.ToolChoice  = data.ToolChoice end
			if data.GuiPos and data.GuiPos.ScaleX then
				Config.GuiPos = UDim2.new(
					data.GuiPos.ScaleX, data.GuiPos.OffsetX,
					data.GuiPos.ScaleY, data.GuiPos.OffsetY
				)
			end
		end
	end)
end

