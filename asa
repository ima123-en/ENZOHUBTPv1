local function doVelocityTP()
    if isTeleporting then
        local wd = tonumber(_G.TacoTPWatchdog) or 25
        if os.clock() - _tpStartT < wd then return end
        _resetTPFlags()
    end
    isTeleporting = true
    _G.TacoTPActive = true
    _G.SMKTIsTeleporting = true
    _tpStartT = os.clock()
    _G.TacoTPStop = false
    _G.TacoStealHold = false
    local ok, err = pcall(function()
        _G.TPStatus = "start"
