local function placeCloneOnly(nearPos)
	local char = LP.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return false end
	local cloner = getCloner()
	if not cloner then return false end
	if cloner.Parent ~= char then
		pcall(function() hum:EquipTool(cloner) end)
		local t0 = os.clock()
		repeat RunService.Heartbeat:Wait() until cloner.Parent == char or os.clock() - t0 > 0.4
	end
	local existing = findClone()
	if existing and nearPos then
		local part = existing:FindFirstChild("HumanoidRootPart") or existing:FindFirstChildWhichIsA("BasePart")
		if part and (part.Position - nearPos).Magnitude < 15 then return true end
	end
	_cloneRef = nil
	local ok = pcall(function() cloner:Activate() end)
	if not ok then pcall(function() firesignal(cloner.Activated) end) end
	local timeout = tonumber(_G.SMKTCloneTimeout) or 2.5
	local t0 = os.clock()
	local retried = false
	while os.clock() - t0 < timeout do
		if cloneAlive() then return true end
		if not retried and os.clock() - t0 > 0.6 then
			retried = true
			if cloner.Parent ~= char then pcall(function() hum:EquipTool(cloner) end) end
			pcall(function() cloner:Activate() end)
		end
		RunService.Heartbeat:Wait()
	end
	return findClone() ~= nil
end

