local function _doVelocityTPInner()
	_G.TPStatus = "start"

	local function abort(reason)
		_G.TPStatus = reason or "aborted"
	end
	local function checkAbort()
		if not isAlive() then abort("player_died_aborted"); return true end
		if _G.TPStatus == "lagback_detected_aborted" then return true end
		if _G.TPStatus == "stall_aborted" then return true end
