	local function scan()
		local results={}
		local catalog={}
		if AnimalsData then
			for idx,info in pairs(AnimalsData) do
				if type(info)=="table" then
					if info.DisplayName then catalog[info.DisplayName:lower()]=idx end
					catalog[tostring(idx):lower()]=idx
				end
			end
		end
		local syncUsed=false
		if _syncChannels then
			syncUsed=true
			for plotKey,ch in pairs(_syncChannels) do
				if type(ch)~="table" then continue end
				local owner=readChannel(ch,"Owner"); if ownerIsMe(owner) then continue end
				local al=readChannel(ch,"AnimalList"); if type(al)~="table" then continue end
				local ownerStr=resolveOwner(owner)
				for slot,ad in pairs(al) do
					if type(ad)~="table" then continue end
					local idx=ad.Index; if not idx then continue end
					local info=AnimalsData and AnimalsData[idx]; if not info then continue end
					if info.Egg or info.LuckyBlock then continue end
					local disp=info.DisplayName or idx
					if tostring(disp):match("^%d+$") then continue end
					local mut=ad.Mutation or "None"
					local gen=calcGen(idx,mut)
					table.insert(results,{
						name=disp,gen=gen,genText=fmt(gen),owner=ownerStr,mutation=mut,
						source="sync",
						plot=tostring(plotKey),slot=tostring(slot),
						uid="sync:"..tostring(plotKey)..":"..tostring(slot),
						pos=resolvePlotPosition(plotKey,slot)
					})
				end
			end
		end
		local pf=Workspace:FindFirstChild("Plots")
		if pf then
			local seen={}
			for _,plot in ipairs(pf:GetChildren()) do
				if isMyPlotVisual(plot) then continue end
				local ownerStr=getOwnerVisual(plot)
				for _,obj in ipairs(plot:GetDescendants()) do
					if not obj:IsA("Model") then continue end
					if seen[obj] then continue end
					local name=obj.Name; local idx=catalog[name:lower()]
					if not idx then local a=obj:GetAttribute("Index") or obj:GetAttribute("Animal"); if a then idx=catalog[tostring(a):lower()] end end
					if not idx then continue end
					local info=AnimalsData[idx]; if not info or info.Egg or info.LuckyBlock then continue end
					seen[obj]=true
					local disp=info.DisplayName or idx
					if tostring(disp):match("^%d+$") then continue end
					local dup=false
					if syncUsed then
						for _,r in ipairs(results) do if r.name==disp and r.owner:lower():find(ownerStr:lower():sub(1,4)) then dup=true; break end end
					end
					if dup then continue end
					local mut=obj:GetAttribute("Mutation") or "None"
					local gen=calcGen(idx,mut)
					local okPos,pivot=pcall(function() return obj:GetPivot() end)
					table.insert(results,{
						name=disp,gen=gen,genText=fmt(gen),owner=ownerStr,mutation=mut,
						source="visual",
						plot=plot.Name,slot=nil,
						uid=getVisualUid(obj),
						pos=okPos and pivot and pivot.Position or nil
					})
				end
				task.wait()
			end
		end

		local priorityIndex={}
		for i,pname in ipairs(priorityList) do
			local lname=pname:lower()
			if priorityIndex[lname]==nil then priorityIndex[lname]=i end
		end

		table.sort(results,function(a,b)
			local pa=priorityIndex[a.name:lower()]
			local pb=priorityIndex[b.name:lower()]
			if pa and pb then
				if pa~=pb then return pa<pb end
			elseif pa and not pb then
				return true
			elseif pb and not pa then
				return false
			end
			if a.source~=b.source then return a.source=="sync" end
			if a.gen~=b.gen then return a.gen>b.gen end
			return a.uid<b.uid
		end)
		return results
	end

