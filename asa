local function _climbCap(hrp, targetY)
	if _G.SMKTClimbFull == true then return tonumber(_G.SMKTClimb) or 160 end
	local diff = targetY - hrp.Position.Y
	if diff > 2 then
		local safe = tonumber(_G.SMKTClimbSafe) or 250
		local full = tonumber(_G.SMKTClimb) or 160
		return diff > 8 and full or safe
	end
	return tonumber(_G.SMKTClimb) or 160
end

local function smktVelMove(hrp, waypoints, speedOverride)
	local state = { done = false, reason = nil }
	if not hrp or not hrp.Parent or #waypoints == 0 then
		state.done = true
		return function() end, state
	end
	local wpIdx     = 1
	local conn
	local stallSec  = tonumber(_G.SMKTStallSec) or 0.6
	local repushAt  = math.min(tonumber(_G.SMKTRepushAt) or 0.9, stallSec * 0.6)
	local lastDist  = math.huge
	local stallT    = os.clock()
	local baseSpeed = _pingAdjustSpeed(speedOverride or tonumber(_G.TPVelocity) or 400)
	local cornerSpd = tonumber(_G.SMKTCornerSpeed) or 140
	local maxReplan = tonumber(_G.SMKTMaxReplans) or 2
	local replans   = 0
	local finalPos  = waypoints[#waypoints]
	local segFrom   = hrp.Position
	local lastCheck = 0
	local blockedHits = 0
	local finalArrive = tonumber(_G.SMKTFinalArrive) or 2.5
	local nearFinal   = 20

	local jumpEnabled  = _G.SMKTJumpRefreshEnabled ~= false
	local jumpInterval = tonumber(_G.SMKTJumpRefreshInterval) or 0.5
	local lastJumpT    = os.clock()

	equipCarpet()
	local function hardStop(reason)
		if state.done then return end
		state.done = true
		state.reason = reason or "ok"
		if conn then conn:Disconnect() end
		if hrp and hrp.Parent then vZero(hrp) end
	end

	local function replan()
		if replans >= maxReplan then return false end
		replans += 1
		local ok, r = pcall(computeRoute, hrp.Position, finalPos)
		if not ok or not r or #r == 0 then return false end
		if (r[1] - hrp.Position).Magnitude < 2 then table.remove(r, 1) end
		if #r == 0 then return false end
		waypoints = r
		wpIdx = 1
		segFrom = hrp.Position
		lastDist = math.huge
		stallT = os.clock()
		blockedHits = 0
		vZero(hrp)
		return true
	end

	conn = RunService.Heartbeat:Connect(function(dt)
		if state.done then return end
		if not isAlive() then _G.TPStatus = "player_died_aborted"; hardStop("died"); return end
		local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
		local pos = hrp.Position
		local target = waypoints[wpIdx]
		local diff   = target - pos
		local mag    = diff.Magnitude
		local isLast = (wpIdx == #waypoints)
		local arrive = isLast and finalArrive or math.max(3.5, baseSpeed * dt * 1.6)

		local reached = mag < arrive
		if not reached and mag < (isLast and 8 or 16) then
			local seg = target - segFrom
			if seg.Magnitude > 0.5 and (pos - target):Dot(seg.Unit) > 0 then reached = true end
		end
		if reached then
			segFrom = target
			wpIdx += 1
			while wpIdx < #waypoints and (waypoints[wpIdx] - pos).Magnitude < arrive do
				segFrom = waypoints[wpIdx]
				wpIdx += 1
			end
			if wpIdx > #waypoints then hardStop("arrived"); return end
			target = waypoints[wpIdx]; diff = target - pos; mag = diff.Magnitude
			isLast = (wpIdx == #waypoints)
			lastDist = math.huge; stallT = os.clock(); equipCarpet()
		end

		local now = os.clock()
		if now - lastCheck > 0.12 then
			lastCheck = now
			if _G.SMKTLookahead ~= false and wpIdx < #waypoints and _clearWide(pos, waypoints[wpIdx + 1]) then
				segFrom = pos
				wpIdx += 1
				target = waypoints[wpIdx]; diff = target - pos; mag = diff.Magnitude
				isLast = (wpIdx == #waypoints)
				lastDist = math.huge; stallT = now
				blockedHits = 0
			elseif (not isLast or mag > 30) and mag > 6 and _block(pos, target, _blocksMove) ~= nil then
				blockedHits += 1
				if blockedHits >= 2 then
					blockedHits = 0
					if replan() then return end
				end
			else
				blockedHits = 0
			end
		end

		if mag < lastDist - 0.1 then lastDist = mag; stallT = now
		else
			local se = now - stallT
			if se > stallSec then
				if isLast and mag < nearFinal then hardStop("near"); return end
				if replan() then return end
				if (pos - finalPos).Magnitude < nearFinal then hardStop("near"); return end
				_G.TPStatus = "stall_aborted"; hardStop("stall"); return
			end
			if se > repushAt then vZero(hrp); equipCarpet(); stallT = now; lastDist = math.huge end
		end

		if mag >= 0.1 then
			local dir = diff.Unit
			local spd = baseSpeed
			if diff.Y > 2 then spd = math.min(spd, _climbCap(hrp, target.Y) + math.abs(diff.Y)*8) end
			if not isLast and mag < 24 then
				local nxt = waypoints[wpIdx + 1] - target
				if nxt.Magnitude > 0.5 and dir:Dot(nxt.Unit) < 0.6 then
					spd = math.min(spd, cornerSpd)
				end
			end
			if isLast and mag < 14 then
				local closeSpd = tonumber(_G.SMKTCloseSpeed) or 80
				spd = math.min(spd, math.max(closeSpd, mag * 12))
			end
			if jumpEnabled and hum and (now - lastJumpT) >= jumpInterval then
				lastJumpT = now
				pcall(function()
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
					hum.Jump = true
				end)
			end
			hrp.AssemblyLinearVelocity = dir * spd
			stabilize(hum)
		end
	end)
	return hardStop, state
end

local function goToBrainrot(brainPos, selRef)
	if not brainPos then return end
	local char = LP.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	equipCarpet(); vZero(hrp); stabilize(hum)

	local needsHover = (brainPos.Y > 20)
		or (brainPos.Y >= 8.0 and brainPos.Y <= 11.0 and Config.TpSettings.TpFloor1WhenFloor2)

	local targetPos
	if brainPos.Y > 20 then
		targetPos = Vector3.new(brainPos.X, brainPos.Y-5, brainPos.Z)
	elseif brainPos.Y >= 8.0 and brainPos.Y <= 11.0 and Config.TpSettings.TpFloor1WhenFloor2 then
		targetPos = Vector3.new(brainPos.X, brainPos.Y-7, brainPos.Z)
	else
		local look = hrp.CFrame.LookVector
		targetPos  = Vector3.new((brainPos - look*3).X, hrp.Position.Y, (brainPos - look*3).Z)
	end

	local mode = Config.TpSettings.TpToBrainrotMode or "Velocity"

	if mode == "Walk" then
		local route = computeRoute(hrp.Position, targetPos)
		local stopMove, mvState = smktVelMove(hrp, route, _pingAdjustSpeed(tonumber(_G.SMKTGoSpeed) or 200))
		local t0 = tick()
		while tick()-t0 < 8 do
			if not isAlive() then break end
			if _G.TPStatus == "lagback_detected_aborted" then break end
			if mvState.done then break end
			if (hrp.Position-targetPos).Magnitude < 3 then break end
			stabilize(hum); task.wait(0.02)
		end
		stopMove(); vZero(hrp)
	end

	if not needsHover then
		if mode ~= "Walk" then
			for _ = 1, 2 do
				if not isAlive() then return end
				if LP:GetAttribute("Stealing") then return end
				local c = LP.Character
				local h = c and c:FindFirstChild("HumanoidRootPart")
				if not h then return end
				equipCarpet(); vZero(h)
				local cf = h.CFrame
				h.CFrame = CFrame.new(targetPos+Vector3.new(0,0.5,0)) *
					CFrame.fromMatrix(Vector3.zero, cf.RightVector, cf.UpVector, cf.LookVector)
				vZero(h); stabilize(hum); task.wait(0.3)
			end
		end
		return
	end

	local freezePos     = targetPos + Vector3.new(0, 1.5, 0)
	local maxHoverTime  = 25
	local t0            = os.clock()
	local holdGain      = 8
	local maxHoldSpeed  = 60
	local snapDist      = 0.2
	local moveThresh    = 0.1
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local c = LP.Character
		local h = c and c:FindFirstChild("HumanoidRootPart")
		local hm = c and c:FindFirstChildOfClass("Humanoid")
		if not h or not hm or hm.Health <= 0 then
			if conn then conn:Disconnect() end
			return
		end
		if LP:GetAttribute("Stealing") then
			if conn then conn:Disconnect() end
			return
		end
		if hm.MoveDirection.Magnitude > moveThresh then
			if conn then conn:Disconnect() end
			return
		end
		local offset = freezePos - h.Position
		local dist   = offset.Magnitude
		if dist > snapDist then
			local spd = math.min(dist * holdGain, maxHoldSpeed)
			h.AssemblyLinearVelocity = offset.Unit * spd
		else
			h.AssemblyLinearVelocity = Vector3.zero
		end
		h.AssemblyAngularVelocity = Vector3.zero
		stabilize(hm)
		equipCarpet()
		local stolen = false
		if selRef and selRef.model and not selRef.model.Parent then stolen = true end
		if not getPrioritySelected() then stolen = true end
		if stolen or (os.clock() - t0) > maxHoverTime or dist > 35 then
			if conn then conn:Disconnect() end
		end
	end)
end

