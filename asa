task.spawn(function()
	local skipIds={"TPPanel","MovementPanel","Actions","CarpetSpeed"}
	for id,entry in pairs(Hub.Toggles) do
		local skip=false
		for _,s in ipairs(skipIds) do if s==id then skip=true; break end end
