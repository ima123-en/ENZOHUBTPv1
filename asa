	local function resolvePlotPosition(plotKey,slot)
		local pf=Workspace:FindFirstChild("Plots"); if not pf then return nil end
		local plotInst=pf:FindFirstChild(tostring(plotKey))
		if not plotInst then
			local num=tostring(plotKey):match("%d+")
			if num then
				for _,pl in ipairs(pf:GetChildren()) do
					local ok,ord=pcall(function() return pl:GetAttribute("Order") end)
					if ok and ord and tostring(ord)==num then plotInst=pl; break end
				end
			end
		end
		if not plotInst then return nil end
		local podiums=plotInst:FindFirstChild("AnimalPodiums")
		if podiums then
			local podium=podiums:FindFirstChild(tostring(slot))
			if podium then local ok,cf=pcall(function() return podium:GetPivot() end); if ok and cf then return cf.Position end end
		end
		local ok2,cf2=pcall(function() return plotInst:GetPivot() end)
		return (ok2 and cf2) and cf2.Position or nil
	end
	local function pickNearest(list)
		local char=LocalPlayer.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return list[1] end
		local best,bestDist=nil,math.huge
		for _,r in ipairs(list) do
			if r.pos then local d=(hrp.Position-r.pos).Magnitude; if d<bestDist then bestDist=d; best=r end end
		end
		return best or list[1]
	end

	local visualUidCache=setmetatable({},{__mode="k"})
