			TweenService:Create(GuiKnob,TweenInfo.new(0.1),{Position=UDim2.new(0,px-5,0.5,-5)}):Play()
		end
	end
	local scale=0.3+(1.0-0.3)*((value-1)/(100-1))
	if instant then GlobalUIScale.Scale=scale
	else TweenService:Create(GlobalUIScale,TweenInfo.new(0.15),{Scale=scale}):Play() end
	updateGuiBox(value); SaveConfig()
end
