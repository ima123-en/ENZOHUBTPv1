	local function applyPrioritySelection(results)
		if activeMode~="Priority" then return end
		local top=results[1]
		if top then
			if not _target or _target.uid~=top.uid then
				local rowFrame=findRowFrameByUID(top.uid)
				setTarget(top,rowFrame)
			end
		end
	end

	local function runScanCycle()
		local results=scan(); lastResults=results; pcall(updateGUI,results)

		if _target then
			local stillExists=false
			local freshEntry=nil
			for _,r in ipairs(lastResults) do
				if r.uid==_target.uid then stillExists=true; freshEntry=r; break end
			end
			if not stillExists then
				setTarget(nil,nil)
				manualPin=false
			else
				_target=freshEntry
				getgenv().SMKT_SelectedData=freshEntry
				getgenv().SMKT_SelectedUID=freshEntry.uid
				if getgenv().PrioritySystem then getgenv().PrioritySystem.SelectedData=freshEntry end
			end
		end

		if manualPin then
		elseif activeMode=="Nearest" then
			local nearest=pickNearest(lastResults)
			if nearest then
				local rowFrame=findRowFrameByUID(nearest.uid)
				setTarget(nearest,rowFrame)
			end
		elseif activeMode=="Priority" then
			applyPrioritySelection(lastResults)
		end
	end

