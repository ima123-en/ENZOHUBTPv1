local function getBrainrotPos(sel)
	if not sel then return nil end
	if sel.worldPosition then return sel.worldPosition end
	if sel.pos then sel.worldPosition = sel.pos; return sel.pos end
	if sel.position and typeof(sel.position) == "Vector3" then
		sel.worldPosition = sel.position; return sel.position
	end
	local plots = Workspace:FindFirstChild("Plots")
	if plots and sel.plot and sel.slot then
		local plot    = plots:FindFirstChild(sel.plot)
		local podiums = plot and plot:FindFirstChild("AnimalPodiums")
		local podium  = podiums and podiums:FindFirstChild(tostring(sel.slot))
		if podium then
			local ok, cf = pcall(function() return podium:GetPivot() end)
			if ok then sel.worldPosition = cf.Position; return cf.Position end
		end
	end
	if sel.model and sel.model.Parent then
		local part = sel.model.PrimaryPart
			or sel.model:FindFirstChild("HumanoidRootPart")
			or sel.model:FindFirstChildWhichIsA("BasePart")
		if part then sel.worldPosition = part.Position; return part.Position end
		local ok, cf = pcall(function() return sel.model:GetPivot() end)
		if ok and cf then sel.worldPosition = cf.Position; return cf.Position end
	end
	return nil
end

local BASES_LOW = {
	[1]=Vector3.new(-476.52,-2,220.94),[2]=Vector3.new(-476.52,-2,113.77),
	[3]=Vector3.new(-476.52,-2,6.18),  [4]=Vector3.new(-476.52,-2,-101.07),
	[5]=Vector3.new(-342.66,-2,221.45),[6]=Vector3.new(-342.66,-2,113.41),
	[7]=Vector3.new(-342.66,-2,6.25),  [8]=Vector3.new(-342.66,-2,-99.73),
}
local BASES_HIGH = {
	[1]=Vector3.new(-479.51,18,220.94),[2]=Vector3.new(-479.51,18,113.77),
	[3]=Vector3.new(-479.51,18,6.18),  [4]=Vector3.new(-479.51,18,-101.07),
	[5]=Vector3.new(-339.48,18,221.45),[6]=Vector3.new(-339.48,18,113.41),
	[7]=Vector3.new(-339.48,18,6.25),  [8]=Vector3.new(-339.48,18,-99.73),
}

local function getBaseIdx(pos)
	local closest, dist = 1, math.huge
	for i = 1, 8 do
		local b = BASES_LOW[i]
		local d = (pos.X-b.X)^2 + (pos.Z-b.Z)^2
		if d < dist then dist = d; closest = i end
	end
	return closest
end

local function isSecondFloor(pos) return pos and pos.Y >= 8.0 and pos.Y <= 11.0 end
local function isThirdFloor(pos)  return pos and pos.Y > 20 end

local function getBaseEntry(idx, isUpper, playerZ)
	local base    = isUpper and BASES_HIGH[idx] or BASES_LOW[idx]
	local frontZ  = math.clamp(playerZ - base.Z, -18, 18) + base.Z
	local coord   = Vector3.new(base.X, isUpper and 16.85 or -3.04, frontZ)
	local faceDir = (idx <= 4) and Vector3.new(-1,0,0) or Vector3.new(1,0,0)
	return { pos = coord, look = faceDir }
end

