local function SaveConfig()
	pcall(function()
		if writefile then
			local data = {
				TpSettings   = Config.TpSettings,
				AutoTpOnLoad = Config.AutoTpOnLoad,
				GuiScale     = Config.GuiScale,
				ToolChoice   = Config.ToolChoice,
