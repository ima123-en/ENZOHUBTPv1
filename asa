local function swapWithClone()
	local remote = getQuantumTeleportRemote()
	if remote then
		local ok, err = pcall(function() remote:FireServer() end)
		if ok then return true end
		warn("[CLONE] Remote fehlgeschlagen:", err)
	end

	local btn = PlayerGui:FindFirstChild("ToolsFrames")
		and PlayerGui.ToolsFrames:FindFirstChild("QuantumCloner")
		and PlayerGui.ToolsFrames.QuantumCloner:FindFirstChild("TeleportToClone")

	if not btn then
		local function search(p)
			for _, c in ipairs(p:GetChildren()) do
				if c:IsA("GuiButton") and c.Name == "TeleportToClone" then return c end
				local f = search(c)
				if f then return f end
			end
			return nil
		end
		btn = search(PlayerGui)
	end

	if btn then
		btn.Visible = true
		if typeof(firesignal) == "function" then
			pcall(function()
				firesignal(btn.MouseButton1Down)
				firesignal(btn.MouseButton1Click)
				firesignal(btn.MouseButton1Up)
			end)
		end
		local inset = GuiService:GetGuiInset()
		local pos   = btn.AbsolutePosition + btn.AbsoluteSize * 0.5
		local VIM   = game:GetService("VirtualInputManager")
		pcall(function()
			VIM:SendMouseButtonEvent(pos.X+inset.X, pos.Y+inset.Y, 0, true,  game, 1)
			task.wait(0.02)
			VIM:SendMouseButtonEvent(pos.X+inset.X, pos.Y+inset.Y, 0, false, game, 1)
		end)
		return true
	end

	warn("[CLONE] Button nicht gefunden, versuche manuelles Teleportieren")
	return manualCloneTeleport()
end

local function doClone()
	if _G._UnifiedIsCloning then return false end
	_G._UnifiedIsCloning = true
	local success = false
	pcall(function()
		if not placeCloneOnly() then
			warn("[CLONE] placeCloneOnly fehlgeschlagen")
			return
		end
		task.wait(0.05)
		if swapWithClone() then
			success = true
		else
			warn("[CLONE] swapWithClone fehlgeschlagen, versuche manuell")
			success = manualCloneTeleport()
		end
	end)
	_G._UnifiedIsCloning = false
	return success
end

local function goToBrainrot(brainPos)
	if not brainPos then return end
	local char = LP.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	equipCarpet(); vZero(hrp); stabilize(hum)
	local targetPos
	if isThirdFloor(brainPos) then
		targetPos = Vector3.new(brainPos.X, brainPos.Y-7, brainPos.Z)
	elseif isSecondFloor(brainPos) and Config.TpSettings.TpFloor1WhenFloor2 then
		targetPos = Vector3.new(brainPos.X, brainPos.Y-10, brainPos.Z)
	else
		local look = hrp.CFrame.LookVector
		targetPos  = Vector3.new((brainPos - look*3).X, hrp.Position.Y, (brainPos - look*3).Z)
	end
	local mode = Config.TpSettings.TpToBrainrotMode or "Velocity"
	if mode == "Velocity" then
		local freezePos = targetPos + Vector3.new(0, 1.5, 0)
		for phase = 1, 2 do
			local c = LP.Character
			local h = c and c:FindFirstChild("HumanoidRootPart")
			local hm= c and c:FindFirstChildOfClass("Humanoid")
			if not h or not hm then break end
			local conns = {}
			local function lockIt()
				if h then h.Anchored=true; h.AssemblyLinearVelocity=Vector3.zero
					h.AssemblyAngularVelocity=Vector3.zero; h.CFrame=CFrame.new(freezePos) end
				equipCarpet()
			end
			table.insert(conns, RunService.RenderStepped:Connect(lockIt))
			table.insert(conns, RunService.Heartbeat:Connect(lockIt))
			task.wait(0.12)
			for _, cn in ipairs(conns) do cn:Disconnect() end
			if h then
				h.Anchored=false; h.AssemblyLinearVelocity=Vector3.zero
				h.AssemblyAngularVelocity=Vector3.zero; h.CFrame=CFrame.new(freezePos)
			end
			if hm then hm.PlatformStand=false; hm:ChangeState(Enum.HumanoidStateType.Running) end
			if not isAlive() then _G.TPStatus="player_died_aborted"; return end
			if (h.Position-freezePos).Magnitude > 35 then _G.TPStatus="lagback_detected_aborted"; return end
			if phase < 2 then task.wait(0.2) end
		end
	elseif mode == "Walk" then
		local route    = computeRoute(hrp.Position, targetPos)
		local stopMove = sabcomVelMove(hrp, route, _pingAdjustSpeed(tonumber(_G.SabcomGoSpeed) or 200))
		local t0 = tick()
		while tick()-t0 < 8 do
			if not isAlive() then break end
			if _G.TPStatus == "lagback_detected_aborted" then break end
			if (hrp.Position-targetPos).Magnitude < 3 then break end
			stabilize(hum); task.wait(0.02)
		end
		stopMove(); vZero(hrp)
	else
		for _ = 1, 2 do
			if not isAlive() then return end
			local c = LP.Character
			local h = c and c:FindFirstChild("HumanoidRootPart")
			if not h then return end
			equipCarpet(); vZero(h)
			local cf = h.CFrame
			h.CFrame = CFrame.new(targetPos+Vector3.new(0,0.5,0)) *
				CFrame.fromMatrix(Vector3.zero, cf.RightVector, cf.UpVector, cf.LookVector)
			vZero(h); stabilize(hum); task.wait(0.3)
		end
	end
end

