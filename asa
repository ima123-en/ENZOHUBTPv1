do
    local function makeSlider(parent, y, label, minV, maxV, getV, setV, fmt)
        local frame = mkPanel(parent, UDim2.new(0.9, 0, 0, 32), UDim2.new(0.05, 0, 0, y))
        mkLabel(frame, UDim2.new(0.6, 0, 0, 16), UDim2.new(0, 8, 0, 4), label:upper(), 10, THEME.TEXT)
        local val = mkLabel(frame, UDim2.new(0, 70, 0, 16), UDim2.new(1, -78, 0, 4), "", 10, THEME.ACCENT, Enum.TextXAlignment.Right)
        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, -16, 0, 6); bar.Position = UDim2.new(0, 8, 1, -12)
        bar.BackgroundColor3 = THEME.BG; bar.BorderSizePixel = 0; bar.Parent = frame
        Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 3)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = THEME.ACCENT; fill.BorderSizePixel = 0; fill.Parent = bar
        Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)
        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 10, 0, 10); knob.Position = UDim2.new(0, -5, 0.5, -5)
        knob.BackgroundColor3 = THEME.TEXT; knob.BorderSizePixel = 0; knob.Parent = bar
        Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 1)
        local dragging = false
        local function updateVis(v, instant)
            v = math.clamp(v, minV, maxV)
            local alpha = (v - minV) / (maxV - minV)
            local len = bar.AbsoluteSize.X
            local px = alpha * len
            val.Text = fmt and fmt(v) or string.format("%.2f", v)
            if instant then
                fill.Size = UDim2.new(0, px, 1, 0)
                knob.Position = UDim2.new(0, px - 5, 0.5, -5)
            else
                TweenService:Create(fill, TweenInfo.new(0.1), { Size = UDim2.new(0, px, 1, 0) }):Play()
                TweenService:Create(knob, TweenInfo.new(0.1), { Position = UDim2.new(0, px - 5, 0.5, -5) }):Play()
            end
        end
        local function fromAlpha(a)
            a = math.clamp(a, 0, 1)
            local v = minV + (maxV - minV) * a
            setV(v); updateVis(v, false); SaveConfigDebounced()
        end
        bar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                fromAlpha((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                fromAlpha((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
                dragging = false
                SaveConfig()
            end
        end)
        task.defer(function() updateVis(getV(), true) end)
    end
    local function fmtInt(v) return string.format("%d", v) end
    local function fmtSec(v) return string.format("%.2fs", v) end
    makeSlider(SettingsGui, 48, "TP Velocity (Carpet)", 80, 750,
        function() return CONFIG.TpV2Speed or 480 end,
        function(v) CONFIG.TpV2Speed = math.floor(v); _G.NeegyCruise = CONFIG.TpV2Speed end, fmtInt)
    makeSlider(SettingsGui, 88, "TP Velocity (Grapple)", 120, 750,
        function() return CONFIG.TpGrappleSpeed or 480 end,
        function(v) CONFIG.TpGrappleSpeed = math.floor(v) end, fmtInt)
    makeSlider(SettingsGui, 128, "Go-To-Brainrot Speed", 20, 400,
        function() return CONFIG.WalkToBrainrotSpd or 400 end,
        function(v) CONFIG.WalkToBrainrotSpd = math.floor(v); _G.SMKTGoSpeed = CONFIG.WalkToBrainrotSpd; _G.SMKTBrainrotSpeed = CONFIG.WalkToBrainrotSpd end, fmtInt)
    makeSlider(SettingsGui, 168, "Clone Delay", 0.01, 1.0,
        function() return CONFIG.CloneDelay or 0.03 end,
        function(v) CONFIG.CloneDelay = v end, fmtSec)
    makeSlider(SettingsGui, 208, "Post-Clone Delay", 0.05, 1.0,
        function() return CONFIG.PostCloneDelay or 0.1 end,
        function(v) CONFIG.PostCloneDelay = v end, fmtSec)
    makeSlider(SettingsGui, 248, "Landing Delay", 0.05, 0.75,
        function() return CONFIG.LandingDelay or 0.15 end,
        function(v) CONFIG.LandingDelay = v; _G.LandingDelay = CONFIG.LandingDelay end, fmtSec)
    makeSlider(SettingsGui, 288, "Close Speed", 20, 250,
        function() return CONFIG.CloseSpeed or 80 end,
        function(v) CONFIG.CloseSpeed = math.floor(v) end, fmtInt)
    makeSlider(SettingsGui, 328, "Climb Speed", 50, 500,
        function() return CONFIG.ClimbSpeed or 200 end,
        function(v) CONFIG.ClimbSpeed = math.floor(v); _G.TacoClimb = CONFIG.ClimbSpeed end, fmtInt)
    local closeBtn = mkButton(SettingsGui, UDim2.new(0.9, 0, 0, 26), UDim2.new(0.05, 0, 0, 372), "CLOSE", 10, THEME.TEXT)
    closeBtn.MouseButton1Click:Connect(function() SettingsGui.Visible = false; SaveConfig() end)
    local resetBtn = mkButton(SettingsGui, UDim2.new(0.9, 0, 0, 26), UDim2.new(0.05, 0, 0, 404), "RESET POSITION", 10, THEME.TEXT)
    resetBtn.MouseButton1Click:Connect(function()
        Main.Position = UDim2.new(1, -285, 0, 70)
        SettingsGui.Visible = false
    end)
end
SettingsButton.MouseButton1Click:Connect(function() SettingsGui.Visible = not SettingsGui.Visible end)

do
    local draggingMain, dragStart, startPos
    Main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingMain = true; dragStart = i.Position; startPos = Main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingMain and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local delta = i.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and draggingMain then
            draggingMain = false
        end
    end)
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if waitingTpKey and input.UserInputType == Enum.UserInputType.Keyboard then
        waitingTpKey = false
        local name = input.KeyCode.Name
        if name and name ~= "Unknown" then
            CONFIG.TpKey = name; TpKeyCode = input.KeyCode
            TpKeyButton.Text = name; TpKeyButton.TextColor3 = THEME.TEXT
            SaveConfig()
        else
            TpKeyButton.Text = CONFIG.TpKey or "T"; TpKeyButton.TextColor3 = THEME.TEXT
        end
        return
    end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == TpKeyCode then task.spawn(doVelocityTP) end
end)

if CONFIG.AutoTpOnLoad then
    task.spawn(function()
        local char = LP.Character or LP.CharacterAdded:Wait()
        char:WaitForChild("HumanoidRootPart", 5); char:WaitForChild("Humanoid", 5)
        task.wait(CONFIG.TpDelay or 0)
        local t0 = tick()
        while tick() - t0 < 8 do
            local sel = getPrioritySelected()
            local pos = sel and getBrainrotPos(sel)
            if sel and pos then task.spawn(doVelocityTP); break end
            task.wait(0.1)
        end
    end)
end

game:BindToClose(function()
    pcall(SaveConfig)
end)
